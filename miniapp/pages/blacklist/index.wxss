.blacklist-page{padding:28rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));background:#f4f8f7;min-height:100vh;box-sizing:border-box}.intro{background:#e5f5ee;padding:28rpx;border-radius:24rpx;color:#49665c;font-size:25rpx;line-height:1.7}.title{font-size:36rpx;font-weight:700;color:#194d3e;margin-bottom:12rpx}.person{display:flex;align-items:center;gap:20rpx;background:white;border-radius:22rpx;padding:24rpx;margin-top:20rpx}.avatar{width:80rpx;height:80rpx;border-radius:50%;flex-shrink:0}.placeholder{background:#e5f5ee;display:flex;align-items:center;justify-content:center}.info{flex:1;min-width:0;color:#75857e;font-size:24rpx}.name{font-size:30rpx;color:#223c32;overflow-wrap:anywhere}.person button{margin:0;color:#246a51;font-size:24rpx;flex-shrink:0}.empty{text-align:center;color:#75857e;padding:50rpx 20rpx}

@import "../../theme.wxss";
