<view class="community"><block wx:if="{{detail}}"><button bindtap="back">返回列表</button><view class="card"><view class="title">{{detail.category}} · {{detail.statusText}}</view><view class="body">{{detail.content}}</view><button wx:for="{{detail.evidence}}" wx:key="id" data-id="{{item.id}}" bindtap="preview">查看证据截图 {{index+1}}</button><view wx:for="{{detail.events}}" wx:key="createdAt" class="card"><view>{{item.statusText}} · {{item.createdAt}}</view><view class="body">{{item.note}}</view></view></view></block><block wx:else><view class="title">{{kind==='REPORT'?'举报用户':'意见反馈'}}</view><view class="notice">举报将由管理员受理、调查并反馈结果，不自动拉黑或处罚对方。请如实描述，勿提交无关个人信息。截图最多5张，压缩后每张400KB。</view><view wx:if="{{kind==='REPORT'}}" class="card"><text>举报对象：{{targetId}}</text><picker range="{{reasons}}" bindchange="reason"><button>{{category}} ›</button></picker></view><textarea maxlength="3000" placeholder="请填写10字以上的具体说明" value="{{content}}" bindinput="input"/><view class="row"><view wx:for="{{evidence}}" wx:key="id"><button size="mini" data-id="{{item.id}}" bindtap="preview">截图 {{index+1}}</button><button size="mini" data-index="{{index}}" bindtap="removeEvidence">移除</button></view></view><button disabled="{{busy||uploading||evidence.length>=5}}" bindtap="addEvidence" loading="{{uploading}}">上传证据截图</button><button disabled="{{busy||uploading}}" loading="{{busy}}" bindtap="submit">提交</button><view class="title">我的反馈与举报</view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}}</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view>{{item.category}} · {{item.statusText}}</view><view class="muted">{{item.createdAt}}</view></view><view wx:if="{{!items.length}}" class="muted">暂无记录</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button></block></view>
