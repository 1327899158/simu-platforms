page{background:#f5f7fb}.invite-page{padding:32rpx 36rpx 64rpx;color:#29324a}.poster{border-radius:40rpx;overflow:hidden;box-shadow:0 20rpx 50rpx rgba(79,107,255,.18)}.poster-brand{padding:48rpx 32rpx 54rpx;text-align:center;background:linear-gradient(160deg,#4f6bff,#6c4cff 55%,#8b5cff);color:#fff}.brand-mark{width:110rpx;height:110rpx;margin:auto;border-radius:32rpx;background:#f4f0ff;color:#6456e9;font-size:60rpx;font-weight:800;line-height:110rpx}.brand-label{font-size:25rpx;margin-top:22rpx;letter-spacing:2rpx}.poster-title{font-size:38rpx;font-weight:800;line-height:1.6;margin-top:24rpx}.poster-title text{color:#5eead4;margin:0 6rpx}.invite-code{display:inline-block;border:1rpx solid rgba(255,255,255,.35);background:rgba(255,255,255,.14);border-radius:999rpx;padding:14rpx 22rpx;font-size:23rpx;margin-top:24rpx}.invite-code text{font-weight:700;letter-spacing:2rpx;margin-left:10rpx}.poster-qr{padding:34rpx;text-align:center;background:white;border-top:8rpx dotted #e4e1fd}.qr-caption{font-size:25rpx;margin-bottom:22rpx}.qr-image,.qr-placeholder{width:280rpx;height:280rpx;margin:auto;border:1rpx solid #e4e7f0;border-radius:24rpx}.qr-placeholder{display:flex;align-items:center;justify-content:center;padding:20rpx;box-sizing:border-box;color:#8c91a3;font-size:23rpx}.muted{font-size:22rpx;line-height:1.6;color:#9097a8;margin-top:16rpx}.center{text-align:center}.actions{display:flex;gap:20rpx;margin-top:24rpx}.actions button{flex:1;min-width:0;margin:0;padding:0 12rpx;line-height:88rpx;background:#5864ed;color:white;border-radius:18rpx;font-size:26rpx;font-weight:600}.actions button::after{border:none}.actions .outline{background:white;color:#5864ed;border:1rpx solid #cfd2fa}.section-title{font-size:29rpx;font-weight:700;margin:36rpx 0 20rpx}.stats,.rules,.records{background:white;border-radius:24rpx;padding:24rpx}.stats{display:flex;justify-content:space-between;text-align:center}.stats view{flex:1;font-size:21rpx;color:#969caf}.stats text{display:block;font-size:36rpx;font-weight:700;color:#5864ed;margin-bottom:10rpx}.rules view{font-size:25rpx;line-height:1.8;padding:14rpx 0;border-bottom:1rpx solid #eef0f5}.rules view:last-child{border:0}.record{display:flex;justify-content:space-between;gap:20rpx;font-size:24rpx;line-height:1.6;padding:18rpx 0;border-bottom:1rpx solid #eef0f5}.record text:last-child{color:#8b92a8;font-size:22rpx}.error{color:#bd573e;background:white;padding:24rpx;border-radius:16rpx;margin-bottom:24rpx}.poster-canvas{position:fixed;left:-2000px;top:-2000px;width:560px;height:920px}
