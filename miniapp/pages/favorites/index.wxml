<view class="community"><view class="title">我的收藏</view><view class="row"><button wx:for="{{tabs}}" wx:key="key" class="{{kind===item.key?'active':''}}" data-key="{{item.key}}" bindtap="tab">{{item.label}}</button></view><view class="notice">已删除、停止公开或结束报价的内容将自动隐藏。</view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}} · 点击重试</view><checkbox-group bindchange="choose"><view wx:for="{{items}}" wx:key="id" class="card"><checkbox value="{{item.id}}" checked="{{item.checked}}"/><text data-id="{{item.id}}" bindtap="open">{{item.title}}</text><view class="row"><button size="mini" data-id="{{item.id}}" bindtap="open">查看</button><button size="mini" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">取消收藏</button></view></view></checkbox-group><view wx:if="{{!items.length&&!busy}}" class="muted">暂无有效收藏</view><button disabled="{{busy||!selected.length}}" bindtap="remove">批量移除（{{selected.length}}）</button><button wx:if="{{nextOffset!==null}}" bindtap="more" loading="{{busy}}">加载更多</button></view>
