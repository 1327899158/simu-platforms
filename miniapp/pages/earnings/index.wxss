@import "../../community.wxss";
@import "../../theme.wxss";
.income-hero{padding:36rpx;border-radius:30rpx;background:#fff6d9;color:#785c28;margin:24rpx 0;font-size:25rpx}.total{font-size:54rpx;font-weight:750;margin:20rpx 0;overflow-wrap:anywhere}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.metrics .card{margin:0 0 18rpx;font-size:23rpx;color:#6b7d82}.metrics .card view{font-size:30rpx;font-weight:700;margin-top:12rpx;color:#34617a;overflow-wrap:anywhere}.trend-row{margin:24rpx 0;font-size:24rpx}.track{height:12rpx;background:#e8f0ee;border-radius:10rpx;margin-top:12rpx;overflow:hidden}.bar{height:100%;background:#4b9ec5;border-radius:10rpx}.money{font-size:27rpx;color:#957032;margin-left:18rpx;flex-shrink:0}.item-title{font-size:27rpx;overflow-wrap:anywhere}
