.page{min-height:100vh;background:var(--bg-base);padding:24rpx;box-sizing:border-box}.hero{padding:30rpx 28rpx;border-radius:var(--r-lg);background:var(--grad-violet-pink);color:#fff;margin-bottom:22rpx}.hero-title{display:block;font-size:36rpx;font-weight:700}.customer{display:flex;align-items:center;gap:18rpx;margin-top:22rpx}.customer image{width:74rpx;height:74rpx;border-radius:50%;background:#fff}.customer-name{display:block;font-size:29rpx;font-weight:700}.hero-sub{display:block;font-size:23rpx;opacity:.84;margin-top:8rpx}.card{background:#fff;border-radius:var(--r-lg);box-shadow:var(--shadow-card);padding:28rpx;margin-bottom:20rpx}.prompt{display:block;color:var(--c-text);font-size:29rpx;font-weight:600;line-height:1.5}.big-stars{display:flex;justify-content:center;margin-top:20rpx}.big-star{font-size:68rpx;color:#D9DCE8;padding:0 5rpx}.big-star.active{color:#F3B63F}.score-label{display:block;text-align:center;color:#A26A00;font-size:24rpx}.section-title{display:block;color:var(--c-text);font-size:28rpx;font-weight:700}.tag-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx}.review-tag{padding:15rpx 20rpx;border-radius:999rpx;background:#F3F4F8;color:#626A79;font-size:24rpx}.review-tag.selected{background:#E3F4FC;color:#158DBF}.private-tip{display:block;margin-top:16rpx;padding:18rpx;border-radius:14rpx;background:#FFF8E8;color:#765B1D;font-size:22rpx;line-height:1.55}.comment-input{width:100%;height:190rpx;margin-top:20rpx;padding:18rpx;box-sizing:border-box;border-radius:14rpx;background:#F7F8FC;font-size:25rpx}.submit{margin:24rpx 0;border:0;border-radius:999rpx;background:var(--grad-violet-pink);color:#fff;font-size:29rpx}.submit::after{border:none}
