@import "../../community.wxss";

@import "../../theme.wxss";
.incentive-hero{background:#e6f1f6;border:1rpx solid #bfd6e1;border-radius:28rpx;padding:28rpx;margin:24rpx 0}.hero-award{width:94rpx;height:94rpx}.task-icon{width:60rpx;height:60rpx;flex-shrink:0}.sign-days{display:flex;justify-content:space-between;gap:8rpx;margin-top:24rpx}.sign-day{text-align:center;font-size:18rpx;color:#85989b}.sign-day view{border-radius:50%;width:46rpx;height:46rpx;line-height:46rpx;background:#e7eeee;margin-bottom:8rpx}.sign-day.done view{background:#55a5bc;color:white}.badge-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.badge-grid .achievement{text-align:center;margin:0}.achievement image{width:82rpx;height:82rpx}.achievement.locked image{opacity:.45}.achievement button{font-size:22rpx;margin-top:12rpx}.task-row{display:flex;gap:16rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #e5eeee}.incentive-page .mini-sign{font-size:22rpx;padding:10rpx 16rpx;margin:0;line-height:1.5;flex-shrink:0}.my-rank{padding:18rpx;background:#fff3d9;border-radius:18rpx;font-size:24rpx}.rank{width:30rpx;color:#a47d2d}
