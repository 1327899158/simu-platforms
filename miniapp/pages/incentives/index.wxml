<view class="community incentive-page">
<view class="between"><view class="title">激励中心</view><text wx:if="{{user.role==='ENGINEER'}}" bindtap="level" class="caption">等级规则 ›</text></view>
<view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 重试</view>
<block wx:if="{{info}}">
<view class="incentive-hero"><view class="between"><view><view class="title">{{user.role==='ENGINEER'?'认真交付，收获成长':'每日参与，收获好礼'}}</view><view class="caption">签到 · 任务 · 成就</view></view><image class="hero-award" src="/assets/icons-contrast/award.svg"/></view><view class="stat-grid"><view class="stat"><view class="number">{{info.weekly}}</view><view class="caption">本周完单</view></view><view class="stat"><view class="number">{{info.total}}</view><view class="caption">累计完单</view></view><view class="stat" bindtap="assets"><view class="number">{{info.reservedCoins}}</view><view class="caption">仿真币 ›</view></view></view></view>
<view class="section-title">每日签到<text class="caption">北京时间 · 每日8币</text></view><view class="card"><view class="between"><image class="task-icon" src="/assets/icons-contrast/calendar.svg"/><view class="grow">每天来看看，积累仿真币</view><button class="primary mini-sign" bindtap="signin" disabled="{{busy||info.checkin.checked}}">{{info.checkin.checked?'今日已签':'签到 +8'}}</button></view><view class="sign-days"><view wx:for="{{info.checkin.calendar}}" wx:key="date" class="sign-day {{item.done?'done':''}}"><view>{{item.done?'✓':item.today?'今':'·'}}</view><text>{{item.label}}</text></view></view></view>
<block wx:if="{{user.role==='ENGINEER'}}"><view class="section-title">本周完单排行榜<text class="caption">真实订单 · 前20名</text></view><view class="card"><view class="between list-row" wx:for="{{info.leaderboard}}" wx:key="id"><text class="rank">{{index+1}}</text><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}"/><view wx:else class="avatar">工</view><text class="grow">{{item.nickname}}</text><text>{{item.completed}} 单</text></view><view class="my-rank">我的排名：{{info.rank}} · 本周 {{info.weekly}} 单</view></view></block>
<view class="section-title">连续完成挑战<text class="caption">连续 {{info.streak}} 天</text></view><view class="card between"><image class="task-icon" src="/assets/icons-contrast/flame.svg"/><view class="grow"><view class="title">连续完成3天订单</view><view class="caption">按真实完成日期统计，与每日签到独立计算。</view></view></view>
<view class="section-title">成就徽章<text class="caption">领取任务奖励后解锁</text></view><view class="badge-grid"><view class="card achievement {{item.earned?'':'locked'}}" wx:for="{{info.tasks}}" wx:key="key"><image src="/assets/icons-contrast/{{item.icon}}.svg"/><view class="title">{{item.title}}</view><view class="caption">{{item.taskTitle}}</view><text class="caption">{{item.earned?'已解锁':'未解锁'}}</text><button wx:if="{{user.role==='ENGINEER' && item.earned}}" data-key="{{item.key}}" data-showing="{{item.showing}}" bindtap="showcase" disabled="{{busy}}">{{item.showing?'取消主页展示':'展示到主页'}}</button></view></view>
<view class="section-title">成就与任务<text class="caption">进度自动同步</text></view><view class="card"><view class="task-row" wx:for="{{info.tasks}}" wx:key="key"><image class="task-icon" src="/assets/icons-contrast/{{item.icon}}.svg"/><view class="grow"><view>{{item.taskTitle}}</view><view class="caption">{{item.value}} / {{item.target}} · +{{item.amount}}币</view><progress percent="{{item.value>=item.target?100:item.value*100/item.target}}" stroke-width="4" activeColor="#4b9cbb"/></view><button class="mini-sign" data-key="{{item.key}}" bindtap="claim" disabled="{{busy||item.claimed||!item.eligible}}">{{item.claimed?'已领取':'领取'}}</button></view></view><view class="notice">卡券与仿真币仅记录待使用权益，暂不抵扣、提现或转让，不影响当前支付。</view>
</block></view>
