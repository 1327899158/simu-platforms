
<view class="community">
 <view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 点击重试</view>
 <view class="hero"><view class="between"><view class="grow"><view class="eyebrow">GROW WITH EVERY PROJECT</view><view class="title">激励中心</view><view class="muted">每一次认真交付，都值得被记录</view></view><view class="hero-icon"><ui-symbol value="🏆"/></view></view>
  <view class="stat-grid" wx:if="{{info}}"><view class="stat"><view class="number">{{info.weekly}}</view><view class="caption">本周完单</view></view><view class="stat"><view class="number">{{info.total}}</view><view class="caption">累计完单</view></view><view class="stat"><view class="number">{{info.reservedCoins}}</view><view class="caption">预留奖励 / 币</view></view></view>
 </view>
 <block wx:if="{{info}}">
  <view class="section-title"><ui-symbol value="🏅"/> 本周完单排行榜<text class="caption">前20名</text></view>
  <view class="card"><view class="list-row between" wx:for="{{info.leaderboard}}" wx:key="id"><view class="rank"><ui-symbol value="{{index===0?'🥇':index===1?'🥈':index===2?'🥉':index+1}}"/></view><view class="avatar">工</view><view class="grow">{{item.nickname}}</view><view class="badge">{{item.completed}} 单</view></view><view class="empty muted" wx:if="{{!info.leaderboard.length}}">本周暂无完成订单，期待您的首次交付</view></view>
  <view class="section-title"><ui-symbol value="🔥"/> 连续交付挑战<text class="caption">连续 {{info.streak}} 天</text></view>
  <view class="card between"><view class="hero-icon"><ui-symbol value="☀"/></view><view class="grow"><view class="title">用专业，积累每一天</view><view class="muted">每天至少完成一单计入连续天数；今天尚未完成时可延续昨天。</view></view></view>
  <view class="section-title"><ui-symbol value="🎖"/> 成就与任务<text class="caption">真实订单统计</text></view>
  <view class="task-grid"><view wx:for="{{info.tasks}}" wx:key="key" class="card task"><view class="empty-icon"><ui-symbol value="{{item.eligible?'🏅':'☘'}}"/></view><view class="title">{{item.title}}</view><view class="caption">进度 {{item.value}} / {{item.target}}</view><progress class="progress" percent="{{item.value>=item.target?100:item.value*100/item.target}}" stroke-width="5" activeColor="#9dbd69" backgroundColor="#edf2e7" border-radius="6"/><view class="badge">＋{{item.amount}} 预留币</view><button class="{{item.eligible&&!item.claimed?'primary':''}}" data-key="{{item.key}}" bindtap="claim" disabled="{{busy||!item.eligible||item.claimed}}">{{item.claimed?'已登记':item.eligible?'领取奖励':'尚未达标'}}</button></view></view>
  <view class="section-title">奖励记录<text class="caption">最近50条</text></view>
  <view class="card"><view class="list-row between" wx:for="{{info.rewards}}" wx:key="createdAt"><view class="grow"><view>{{item.taskKey}}</view><view class="caption">{{item.periodKey}} · {{item.createdAt}}</view></view><view><view class="badge">＋{{item.amount}} 币</view><view class="caption">预留中</view></view></view><view wx:if="{{!info.rewards.length}}" class="muted empty">暂无奖励记录，达标后记得领取</view></view>
  <view class="notice"><ui-symbol value="💡"/> 奖励仅登记为预留权益，暂不可抵扣、提现或转让，不影响支付。自然周从北京时间周一开始，本周起始：{{info.period}}。</view>
 </block>
</view>
