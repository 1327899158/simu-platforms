<view class="wrap"><text class="title">找到合适的仿真工程师</text><view class="chips"><view class="chip {{!direction?'selected':''}}" data-value="" bindtap="filter">全部</view><view wx:for="{{categories}}" wx:key="*this" class="chip {{direction===item?'selected':''}}" data-value="{{item}}" bindtap="filter">{{item}}</view></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openProfile"><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"/><text class="heading">{{item.nickname || '工程师'}}</text><view class="ui-icon-copy engineer-level-tag level-{{item.level.key}}"><ui-symbol value="{{item.level.icon}}"/> {{item.level.name}}</view><text class="muted">好评率 {{item.positiveText}} · 点击查看资料与案例 ›</text><view class="chips"><text class="chip" wx:for="{{item.specialties}}" wx:key="*this">{{item}}</text></view><button data-id="{{item.id}}" catchtap="contact">发起沟通</button></view><text class="muted">{{loading?'加载中…':items.length?'上拉查看更多':'该方向暂无已认证工程师'}}</text></view>
