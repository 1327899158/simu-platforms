<view class="community"><view class="title">钱包、提现及银行卡</view><view class="notice">当前仅模拟账本。与订单收益、真实支付完全隔离，不产生实际到账；不收集真实银行卡信息。测试余额由超级管理员审核后模拟入账。</view><view class="error" wx:if="{{error}}" bindtap="retry">{{error}} · 重试</view><block wx:if="{{info}}">
<view class="finance-hero"><text>模拟可提现余额</text><view class="finance-amount">¥{{info.available}}</view><view>冻结中 ¥{{info.frozen}}</view><view class="finance-note" selectable>测试用户ID：{{userId}}</view></view>
<view class="card"><view class="title">模拟提现金额</view><view class="between"><input class="finance-input grow" type="digit" value="{{amount}}" bindinput="input" placeholder="请输入金额（元）"/><button size="mini" bindtap="all">全部</button></view><view class="finance-row" bindtap="bank"><text>提现至</text><text>{{info.cards.length?info.cards[0].bankName+' · 尾号'+info.cards[0].lastFour:'绑定模拟银行卡'}} ›</text></view><view class="caption">当前模拟手续费：0元；真实费率及通道后续接入验收。</view><button class="primary" bindtap="withdraw" loading="{{busy}}" disabled="{{busy}}">提交模拟提现</button></view>
<view class="finance-tabs"><button class="{{tab==='withdrawals'?'active':''}}" data-tab="withdrawals" bindtap="tab">提现记录</button><button class="{{tab==='ledger'?'active':''}}" data-tab="ledger" bindtap="tab">余额账本</button><button class="{{tab==='holds'?'active':''}}" data-tab="holds" bindtap="tab">冻结记录</button></view>
<block wx:if="{{tab==='withdrawals'}}"><view class="card" wx:for="{{info.withdrawals}}" wx:key="id"><view class="between"><text class="finance-value">¥{{item.amount}}</text><text>{{item.label}}</text></view><view class="caption">{{item.bankLabel}} · {{item.createdAt}}</view><view class="finance-note">{{item.note}}</view><button wx:if="{{item.status==='SUBMITTED'}}" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">撤销申请</button></view><view wx:if="{{!info.withdrawals.length}}" class="empty">暂无模拟提现</view></block>
<block wx:elif="{{tab==='ledger'}}"><view class="card" wx:for="{{info.ledger}}" wx:key="id"><view>{{item.note}}</view><view class="finance-note">可用变动 ¥{{item.change}} · 冻结变动 ¥{{item.frozenChange}}</view><view class="caption">变动后可用 ¥{{item.balance}} · {{item.createdAt}}</view><view class="caption" selectable>{{item.businessKey}}</view></view><view wx:if="{{!info.ledger.length}}" class="empty">暂无账本记录</view></block>
<block wx:else><view class="card" wx:for="{{info.holds}}" wx:key="id"><view class="between"><text>¥{{item.amount}}</text><text>{{item.label}}</text></view><view class="caption">{{item.createdAt}} · 提现申请冻结</view></view><view wx:if="{{!info.holds.length}}" class="empty">暂无冻结记录</view></block><button wx:if="{{info.nextOffset!==null}}" bindtap="more">加载更多</button></block></view>
