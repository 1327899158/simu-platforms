/* home · 设计稿 1:1 还原 */
.page-container {
  min-height: 100vh;
  padding: 20rpx 20rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.hero-illust { width: 300rpx; height: 300rpx; }
.campaign-swiper{height:280rpx;margin:24rpx 0}.campaign-banner{margin:0 4rpx;height:220rpx;padding:26rpx 30rpx;background:linear-gradient(120deg,#ffdf6e,#fff0b3);border-radius:28rpx;box-sizing:border-box;display:flex;flex-direction:column;gap:12rpx;color:#42351d}.campaign-kicker{font-size:22rpx}.campaign-title{display:block;font-size:29rpx;font-weight:700}.home-notice{background:#fff0d9;border-left:8rpx solid #e6ac39;padding:22rpx;border-radius:16rpx;margin:14rpx 0;font-size:27rpx;color:#664917}.notice-project{display:block;font-size:23rpx;margin-top:8rpx}.estimate-entry{padding:30rpx;border-radius:28rpx;background:#e0eef6;display:flex;flex-direction:column;gap:18rpx;margin:26rpx 0}.estimate-cta{color:#285f77;font-weight:700}.category-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin:20rpx 0}.category-chip{background:white;padding:18rpx 24rpx;border-radius:16rpx;font-size:25rpx}.recommended-card{display:flex;align-items:center;gap:20rpx;padding:24rpx;background:white;border-radius:24rpx;margin:18rpx 0}.recommended-card image{width:82rpx;height:82rpx;border-radius:50%;flex-shrink:0}.engineer-copy{flex:1;min-width:0;font-size:23rpx;line-height:1.8}.recommended-card button{font-size:22rpx;background:#f8df83;padding:0 16rpx;flex-shrink:0}
