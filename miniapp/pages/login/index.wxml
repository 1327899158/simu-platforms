<view class="page-container">
  <view class="bg-glow bg-glow-1"></view>
  <view class="bg-glow bg-glow-2"></view>
  <view class="bg-grid"></view>

  <!-- 一键登录首页：采用原型的“品牌展示 + 底部登录面板”布局。 -->
  <block wx:if="{{tab === 'wechat' && !needProfile}}">
    <view class="landing-hero">
      <view class="skip-link" bindtap="goGuestMarket">跳过 <text>›</text></view>

      <view class="mascot-stage">
        <view class="orbit orbit-outer"></view>
        <view class="orbit orbit-inner"></view>
        <view class="orbit-dot orbit-dot-cyan"></view>
        <view class="orbit-dot orbit-dot-yellow"></view>
        <image class="hero-illust hero-illust-custom" src="/assets/login-hero-mascot.png" mode="aspectFit" />

        <view class="tech-chip chip-cfd"><text>🌊</text><text>CFD</text></view>
        <view class="tech-chip chip-structure"><text>🔩</text><text>结构</text></view>
        <view class="tech-chip chip-emc"><text>📡</text><text>EMC</text></view>
        <view class="tech-chip chip-thermal"><text>🔥</text><text>热仿真</text></view>
      </view>

      <view class="brand-copy">
        <text class="ribbon">你好呀，忙碌的仿真伙伴！</text>
        <text class="brand-title">仿真服务平台</text>
        <text class="brand-subtitle">连接工程师与仿真需求</text>
      </view>

      <view class="hero-trust-row">
        <view class="hero-trust-chip"><text>👨‍🔧</text><text>专业工程师</text></view>
        <view class="hero-trust-chip"><text>⚡</text><text>快速响应</text></view>
        <view class="hero-trust-chip"><text>🛡️</text><text>平台担保</text></view>
      </view>
    </view>

    <view class="login-sheet">
      <view class="sheet-handle"></view>

      <view class="engineer-proof">
        <view class="proof-avatars">
          <view class="proof-avatar avatar-one">林</view>
          <view class="proof-avatar avatar-two">陈</view>
          <view class="proof-avatar avatar-three">王</view>
        </view>
        <view class="proof-copy">
          <text class="proof-title">18,000+ 位工程师已入驻</text>
          <text class="proof-desc">覆盖结构、流体、电磁、热仿真等领域</text>
        </view>
      </view>

      <view class="stat-row">
        <view class="stat-card"><text class="stat-icon">⚡</text><text class="stat-value">1.8h</text><text class="stat-label">平均响应</text></view>
        <view class="stat-card"><text class="stat-icon">⭐</text><text class="stat-value">98.2%</text><text class="stat-label">服务好评</text></view>
        <view class="stat-card"><text class="stat-icon">🛡️</text><text class="stat-value">100%</text><text class="stat-label">平台担保</text></view>
      </view>

      <scroll-view class="service-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="service-track">
          <view class="service-chip"><text>🌊</text><text>流体仿真 CFD</text></view>
          <view class="service-chip"><text>🔩</text><text>结构强度分析</text></view>
          <view class="service-chip"><text>📡</text><text>电磁兼容 EMC</text></view>
          <view class="service-chip"><text>🔥</text><text>热仿真</text></view>
          <view class="service-chip"><text>⚡</text><text>振动噪声</text></view>
          <view class="service-chip"><text>🧪</text><text>材料仿真</text></view>
        </view>
      </scroll-view>

      <view class="role-select landing-role-select">
        <text class="role-label">请选择你的身份</text>
        <view class="role-options">
          <view class="role-item {{role === 'customer' ? 'active' : ''}}" data-role="customer" bindtap="selectRole">
            <view class="role-check" wx:if="{{role === 'customer'}}">✓</view>
            <image class="role-image" src="/images/customer.png" mode="aspectFit" />
            <view class="role-copy"><text class="role-text">我是客户</text><text class="role-desc">发布需求，寻找工程师</text></view>
          </view>
          <view class="role-item {{role === 'engineer' ? 'active' : ''}}" data-role="engineer" bindtap="selectRole">
            <view class="role-check" wx:if="{{role === 'engineer'}}">✓</view>
            <image class="role-image" src="/images/engineer.png" mode="aspectFit" />
            <view class="role-copy"><text class="role-text">我是工程师</text><text class="role-desc">承接项目，提供服务</text></view>
          </view>
        </view>
      </view>

      <button class="btn btn-primary btn-block main-login-btn" loading="{{loading}}" bindtap="wxLogin">
        <text class="wechat-mark">●</text><text>微信一键登录</text>
      </button>
      <button class="btn btn-outline btn-block secondary-login-btn" data-tab="phone" bindtap="switchTab">📱 手机号登录</button>
      <button class="guest-entry" bindtap="goGuestMarket">👀 暂不登录，先随便看看</button>

      <view class="agreement-row" bindtap="showAgreementDialog">
        <view class="agreement-dot {{agreementAccepted ? 'checked' : ''}}"><text wx:if="{{agreementAccepted}}">✓</text></view>
        <text>{{agreementAccepted ? '已阅读并同意' : '请阅读并同意'}}<text class="agreement-link">《平台服务协议》</text>和<text class="agreement-link">《隐私政策》</text></text>
      </view>
    </view>

    <view class="landing-footer">专业工程师 · 快速响应 · 平台担保交易 · 全流程售后保障</view>
  </block>

  <!-- 其他登录流程使用紧凑品牌头，保持入口间的视觉连续性。 -->
  <block wx:else>
    <view class="compact-header">
      <view class="compact-back" wx:if="{{!needProfile}}" data-tab="wechat" bindtap="switchTab">‹</view>
      <view class="compact-mascot-wrap">
        <view class="compact-halo"></view>
        <image class="compact-mascot" src="/assets/hero-laptop.png" mode="aspectFit" />
      </view>
      <view class="compact-brand-copy">
        <text class="compact-title">{{needProfile ? '欢迎来到仿真服务平台' : '登录仿真服务平台'}}</text>
        <text class="compact-subtitle">连接工程师与仿真需求</text>
      </view>
    </view>

    <!-- 手机号登录：第一步输入手机号 -->
    <view class="form-container phone-login-card" wx:if="{{tab === 'phone' && phoneStep === 'phone'}}">
      <text class="login-heading">登录后，体验完整功能</text>
      <text class="login-desc">未注册的手机号验证通过后将自动创建账号</text>

      <view class="phone-field">
        <view class="country-code"><text>+86</text></view>
        <view class="field-divider"></view>
        <input class="phone-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" maxlength="11" />
      </view>

      <view class="text-link" bindtap="switchAccountLogin">⇄ 切换账号密码登录</view>

      <view class="role-select compact-role-select">
        <text class="role-label">选择身份（新用户注册用）</text>
        <view class="role-options">
          <view class="role-item {{role === 'customer' ? 'active' : ''}}" data-role="customer" bindtap="selectRole">
            <image class="role-image" src="/images/customer.png" mode="aspectFit" /><text class="role-text">我是客户</text>
          </view>
          <view class="role-item {{role === 'engineer' ? 'active' : ''}}" data-role="engineer" bindtap="selectRole">
            <image class="role-image" src="/images/engineer.png" mode="aspectFit" /><text class="role-text">我是工程师</text>
          </view>
        </view>
      </view>

      <button class="btn btn-primary btn-block login-action" loading="{{smsSending}}" bindtap="proceedPhoneLogin">验证并登录</button>
      <text class="agreement-tip" bindtap="showAgreementDialog">{{agreementAccepted ? '已同意《平台服务协议》和《隐私政策》' : '继续后需确认《平台服务协议》和《隐私政策》'}}</text>
      <button class="guest-entry" bindtap="goGuestMarket">以游客身份浏览接单大厅</button>
    </view>

    <!-- 手机号登录：第二步输入验证码 -->
    <view class="form-container phone-login-card verification-card" wx:if="{{tab === 'phone' && phoneStep === 'code'}}">
      <view class="back-link" bindtap="switchPhoneStep">‹ 返回修改手机号</view>
      <text class="login-heading">输入验证码</text>
      <text class="login-desc">验证码已发送至 +86 {{phone}}</text>

      <input class="verification-input" type="number" placeholder="请输入 6 位验证码" value="{{smsCode}}" bindinput="onSmsCode" maxlength="6" />
      <view class="resend-row">
        <text class="text-link" wx:if="{{smsCountdown <= 0}}" bindtap="phoneRequestSms">重新获取验证码</text>
        <text class="countdown-text" wx:else>{{smsCountdown}} 秒后可重新获取</text>
      </view>
      <button class="btn btn-primary btn-block login-action" loading="{{loading}}" bindtap="phoneLogin">登录</button>
    </view>

    <!-- 账号密码登录 / 注册 -->
    <view class="form-container account-login-card" wx:if="{{tab === 'phone' && phoneStep === 'account'}}">
      <view class="back-link" bindtap="switchPhoneLogin">‹ 手机号验证码登录</view>
      <text class="login-heading">{{isRegister ? '创建账号' : '账号密码登录'}}</text>
      <text class="login-desc">{{isRegister ? '使用手机号验证完成账号注册' : '输入用户名和密码继续'}}</text>
      <view class="switch-login reset-link-top" wx:if="{{!isRegister}}" bindtap="goResetPassword"><text>忘记密码？去重置 →</text></view>

      <view class="sub-tab">
        <view class="sub-tab-item {{!isRegister ? 'active' : ''}}" data-mode="login" bindtap="toggleRegister">登录</view>
        <view class="sub-tab-item {{isRegister ? 'active' : ''}}" data-mode="register" bindtap="toggleRegister">注册</view>
      </view>

      <view class="form-group">
        <text class="form-label">用户名</text>
        <view class="input-wrapper"><text class="input-prefix">👤</text><input class="form-input" placeholder="{{isRegister ? '6-12位数字用户名' : '请输入用户名'}}" value="{{username}}" bindinput="onUsername" maxlength="12" /></view>
      </view>
      <view class="form-group" wx:if="{{isRegister}}">
        <text class="form-label">手机号</text>
        <view class="input-wrapper"><text class="input-prefix">📱</text><input class="form-input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhone" maxlength="11" /></view>
      </view>
      <view class="form-group">
        <text class="form-label">密码</text>
        <view class="input-wrapper"><text class="input-prefix">🔒</text><input class="form-input" password placeholder="{{isRegister ? '请设置密码（至少6位）' : '请输入密码'}}" value="{{password}}" bindinput="onPassword" maxlength="50" /></view>
      </view>
      <view class="form-group" wx:if="{{isRegister}}">
        <text class="form-label">确认密码</text>
        <view class="input-wrapper"><text class="input-prefix">🔐</text><input class="form-input" password placeholder="请再次输入密码" value="{{passwordConfirm}}" bindinput="onPasswordConfirm" maxlength="50" /></view>
      </view>
      <view class="form-group" wx:if="{{isRegister}}">
        <text class="form-label">验证码</text>
        <view class="input-wrapper code-wrapper">
          <text class="input-prefix">📨</text><input class="form-input code-input" type="number" placeholder="请输入6位验证码" value="{{smsCode}}" bindinput="onSmsCode" maxlength="6" />
          <view class="code-btn {{smsCountdown > 0 ? 'disabled' : ''}}" bindtap="phoneRequestSms">{{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}</view>
        </view>
      </view>
      <view class="role-select" wx:if="{{isRegister}}">
        <text class="role-label">选择身份</text>
        <view class="role-options">
          <view class="role-item {{role === 'customer' ? 'active' : ''}}" data-role="customer" bindtap="selectRole"><image class="role-image" src="/images/customer.png" mode="aspectFit" /><text class="role-text">我是客户</text></view>
          <view class="role-item {{role === 'engineer' ? 'active' : ''}}" data-role="engineer" bindtap="selectRole"><image class="role-image" src="/images/engineer.png" mode="aspectFit" /><text class="role-text">我是工程师</text></view>
        </view>
      </view>

      <button wx:if="{{!isRegister}}" class="btn btn-primary btn-block" loading="{{loading}}" bindtap="accountLogin">登 录</button>
      <button wx:else class="btn btn-primary btn-block" loading="{{loading}}" bindtap="accountRegister">注 册</button>
      <button class="guest-entry" bindtap="goGuestMarket">以游客身份浏览接单大厅</button>
    </view>

    <!-- 微信登录后资料完善 -->
    <view class="form-container wechat-login-card" wx:if="{{tab === 'wechat' && needProfile}}">
      <view class="profile-setup">
        <text class="login-heading">完善个人资料</text>
        <text class="login-desc">选择头像并输入昵称，其他用户将看到这些信息</text>
        <view class="avatar-picker-row">
          <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{tempAvatarPath}}" src="{{tempAvatarPath}}" mode="aspectFill" class="avatar-img" />
            <view wx:else class="avatar-placeholder"><text>点击选择</text><text>头像</text></view>
          </button>
        </view>
        <view class="form-group"><text class="form-label">昵称</text><view class="input-wrapper"><text class="input-prefix">✏️</text><input class="form-input" type="nickname" placeholder="点击输入昵称" value="{{nickname}}" bindinput="onNicknameInput" maxlength="60" /></view></view>
        <button class="btn btn-primary btn-block" loading="{{loading}}" bindtap="saveProfile">保存并进入</button>
        <view class="switch-login" bindtap="skipProfile"><text>暂时跳过 →</text></view>
      </view>
    </view>

    <view class="footer"><text>© 2026 仿真服务平台</text></view>
  </block>
</view>
