.page { min-height: 100vh; background: var(--bg-base); padding: 24rpx; box-sizing: border-box; }
.profile-card { display: flex; gap: 22rpx; padding: 28rpx; background: var(--bg-card); border-radius: var(--r-lg); box-shadow: var(--shadow-card); }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; flex-shrink: 0; overflow: hidden; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; background: var(--grad-violet-pink); color: #fff; font-size: 48rpx; }
.profile-copy { min-width: 0; display: flex; flex: 1; flex-direction: column; }
.name { color: var(--c-text); font-size: 34rpx; font-weight: 700; }
.intro { color: var(--c-text-2); font-size: 24rpx; margin-top: 12rpx; line-height: 1.5; }
.rating-card { display: flex; align-items: center; gap: 22rpx; padding: 26rpx 30rpx; margin: 20rpx 0; border-radius: var(--r-lg); background: var(--grad-violet-pink); color: #fff; }
.rating-number { font-size: 58rpx; font-weight: 700; }
.rating-title, .rating-sub { display: block; }
.rating-title { font-size: 28rpx; font-weight: 600; }.rating-sub { font-size: 22rpx; opacity: .82; margin-top: 8rpx; }
.card { background: var(--bg-card); border-radius: var(--r-lg); box-shadow: var(--shadow-card); padding: 26rpx; }
.section-title { color: var(--c-text); font-size: 29rpx; font-weight: 700; }.reviews-title { margin: 28rpx 4rpx 16rpx; }
.tag-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 18rpx; }.label { color: var(--c-text-3); font-size: 23rpx; margin-right: 6rpx; }.tag { color: var(--neon-violet); background: rgba(102,126,234,.1); border-radius: var(--r-pill); padding: 6rpx 14rpx; font-size: 22rpx; }
.empty { padding: 56rpx; color: var(--c-text-3); text-align: center; font-size: 25rpx; }.review-card { background: var(--bg-card); box-shadow: var(--shadow-card); border-radius: var(--r-lg); padding: 24rpx; margin-bottom: 18rpx; }.review-head { display: flex; justify-content: space-between; color: var(--c-text); font-size: 27rpx; font-weight: 600; }.score { color: #E39B00; }.score-lines { display: flex; flex-wrap: wrap; gap: 12rpx; color: var(--neon-violet); font-size: 22rpx; margin: 16rpx 0; }.review-content { color: var(--c-text-2); font-size: 25rpx; line-height: 1.6; }

/* ===== design 1:1 ===== */
.profile-card { background: linear-gradient(160deg, #BEE3F0, #DDEBD9); border-radius: 32rpx; }
.rating-card { background: #F7F3C9; border-radius: 32rpx; }
.card { border-radius: 32rpx; }
.review-card { background: #FFFFFF; border-radius: 32rpx; }
.rating-card{color:#594f29}.case-card{background:#fff;border-radius:28rpx;padding:28rpx;margin:20rpx 0;box-shadow:var(--shadow-card)}.case-top{display:flex;gap:18rpx;align-items:flex-start}.case-symbol{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:64rpx;height:64rpx;background:#e5f0e1;color:#355e4a;border-radius:18rpx;font-size:36rpx}.case-month,.case-note{display:block;color:#758174;font-size:23rpx;line-height:1.7;margin-top:10rpx}.case-summary{display:block;font-size:26rpx;color:#3b5143;line-height:1.8;white-space:pre-wrap;margin-top:22rpx;overflow-wrap:anywhere}.case-top .section-title{overflow-wrap:anywhere}.contact-button{background:#355e4a;color:white;border-radius:22rpx;margin:24rpx 0;font-size:28rpx}

@import "../../theme.wxss";
.profile-heading{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 24rpx;font-size:30rpx;font-weight:600}
