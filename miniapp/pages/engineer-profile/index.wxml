<view wx:if="{{error}}" class="empty" bindtap="load">{{error}} · 点击重试</view>
<view wx:if="{{loading}}" class="empty">加载资料中…</view>
<view class="page" wx:if="{{profile && !error}}">
  <view class="profile-heading"><text>工程师资料</text><profile-actions user-id="{{id}}" enabled="{{canManagePeer}}"/></view>
  <view class="profile-card">
    <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar avatar-fallback">{{profile.nickname[0] || '工'}}</view>
    <view class="profile-copy">
      <text class="name">{{profile.nickname}}</text>
      <view wx:if="{{profile.level}}" class="ui-icon-copy engineer-level-tag level-{{profile.level.key}}" bindtap="showLevel"><ui-symbol value="{{profile.level.icon}}"/> {{profile.level.name}}</view>
      <text class="intro">{{profile.intro || '该工程师暂未填写个人简介'}}</text>
    </view>
  </view>
  <view class="profile-actions-row"><button class="collect-button" wx:if="{{canManagePeer}}" bindtap="favoriteEngineer"><image src="/assets/icons-contrast/collection-star.svg" mode="aspectFit"/>收藏工程师</button><button class="cooperate-button" wx:if="{{canContact}}" bindtap="cooperation">常驻合作 / 定向下单</button></view>
  <view class="profile-badges" wx:if="{{profile.badges.length}}"><view wx:for="{{profile.badges}}" wx:key="key"><image src="/assets/icons-contrast/{{item.icon}}.svg" mode="aspectFit"/><text>{{item.title}}</text></view></view>
  <view class="case-note" wx:if="{{profile.cooperation.enabled}}" bindtap="cooperation">定向下单专享 · 工程师让利 {{profile.cooperation.discountBps/1000}} 折 · 首单适用，优惠体现在工程师报价中 ›</view>
  <view class="rating-card">
    <text class="rating-number">{{profile.averageScore === null ? '--' : profile.averageScore}}</text>
    <view><text class="rating-title">综合评分 / 5.0</text><text class="rating-sub">{{profile.reviewCount}} 条客户评价</text></view>
  </view>
  <view class="card" wx:if="{{profile.specialties.length || profile.softwares.length}}">
    <text class="section-title">专业资料</text>
    <view class="tag-row"><text class="label">方向</text><text class="tag" wx:for="{{profile.specialties}}" wx:key="*this">{{item}}</text></view>
    <view class="tag-row"><text class="label">软件</text><text class="tag" wx:for="{{profile.softwares}}" wx:key="*this">{{item}}</text></view>
  </view>
  <button wx:if="{{canContact}}" class="contact-button" bindtap="contact" loading="{{contacting}}" disabled="{{contacting}}">发起沟通</button>

  <view class="section-title reviews-title">精选案例 · {{caseTotal}}</view>
  <text class="case-note">工程师自主选择的已完成项目；仅展示经确认的公开介绍。</text>
  <view class="empty" wx:if="{{!cases.length}}">该工程师暂未公开展示案例</view>
  <view class="case-card" wx:for="{{cases}}" wx:key="id">
    <view class="case-top"><text class="case-symbol">✓</text><view><text class="section-title">{{item.title}}</text><text class="case-month">{{item.completedMonth}} 完成</text></view></view>
    <text class="case-summary">{{item.summary}}</text>
    <case-gallery ids="{{item.imageIds}}"/><view class="case-collect-row"><button class="collect-button" data-id="{{item.id}}" bindtap="favoriteCase"><image src="/assets/icons-contrast/collection-star.svg" mode="aspectFit"/>收藏案例</button></view>
    <view class="tag-row"><text class="tag" wx:for="{{item.directions}}" wx:for-item="direction" wx:key="*this">{{direction}}</text><text class="tag" wx:for="{{item.softwares}}" wx:for-item="software" wx:key="*this">{{software}}</text></view>
  </view>
  <button wx:if="{{nextOffset !== null}}" bindtap="moreCases" disabled="{{loadingCases}}" loading="{{loadingCases}}">查看更多案例</button>
  <view class="section-title reviews-title">客户评价</view>
  <view class="empty" wx:if="{{!profile.reviews.length}}">该工程师暂未获得评价</view>
  <view class="review-card" wx:for="{{profile.reviews}}" wx:key="id">
    <view class="review-head"><text>{{item.customerNickname}}</text><text class="score">★ {{item.averageScore}}</text></view>
    <view class="score-lines"><text>质量 {{item.qualityScore}} 星</text><text>态度 {{item.attitudeScore}} 星</text><text>速度 {{item.speedScore}} 星</text><text>专业 {{item.professionalScore}} 星</text><text>沟通 {{item.communicationScore}} 星</text></view>
    <text class="review-content">{{item.contentText}}</text>
  </view>
</view>
