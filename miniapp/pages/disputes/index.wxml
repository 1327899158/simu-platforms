<view class="page-container">

  <view class="page-header illustrated-panel"><image class="panel-art support-art" src="/assets/commit.png" mode="aspectFit" aria-hidden="true"/>
    <view class="ui-icon-copy page-title"><ui-symbol value="⚖"/> 我的纠纷</view>
  </view>

  <!-- 常驻状态筛选 -->
  <view class="filter-wrap">
    <view class="filter-panel">
      <button wx:for="{{tabs}}" wx:key="key"
        class="filter-item {{tab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}" bindtap="pickTab">
        <text class="status-dot {{item.dotCls}}"></text>
        <text class="filter-label">{{item.label}}</text>
      </button>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view wx:for="{{items}}" wx:key="id" class="dispute-card" data-id="{{item.id}}" bindtap="open" hover-class="card-hover">
      <view class="card-top">
        <view class="ui-icon-copy reason-icon"><ui-symbol value="{{item.reasonType === 'QUALITY' ? '📉' : item.reasonType === 'DELAY' ? '⏰' : item.reasonType === 'MISSING' ? '📭' : item.reasonType === 'PAYMENT' ? '💳' : item.reasonType === 'COMMUNICATION' ? '💬' : '📌'}}"/></view>
        <view class="card-grow">
          <view class="title-row">
            <text class="card-title">{{item.reasonText}}</text>
            <text class="role-tag {{item.myRole === 'INITIATOR' ? 'mine' : 'other'}}">{{item.myRole === 'INITIATOR' ? '我提出' : '对方提出'}}</text>
          </view>
          <text class="card-sub">{{item.orderName}} · {{item.orderNo}}</text>
        </view>
        <text class="status {{item.badgeCls}}">{{item.statusText}}</text>
      </view>
      <view class="card-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="card-footer">
        <view class="ui-icon-copy time"><ui-symbol value="📆"/> {{item.time}}</view>
        <text class="detail-link">查看详情 ›</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !items.length}}">
      <view class="ui-icon-copy empty-icon"><ui-symbol value="⚖"/></view>
      <text class="empty-text">暂无纠纷记录</text>
    </view>
    <view class="loading" wx:if="{{loading}}">正在加载…</view>
  </view>

</view>
