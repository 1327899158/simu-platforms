<view class="community"><view class="title">卡券与仿真币</view><view wx:if="{{error}}" class="error" bindtap="retry">{{error}}</view><block wx:if="{{info}}"><view class="finance-hero"><view>我的仿真币</view><view class="finance-amount">{{info.balance}}</view><view class="caption">累计领取权益 · 暂不抵扣、提现或转让</view><button bindtap="signin">每日签到 +8 ›</button></view>
<view class="section-title">活动礼包</view><view class="card between" wx:for="{{info.offers}}" wx:key="key"><view class="grow"><view>{{item.title}}</view><view class="finance-value">{{item.amountText}}</view></view><button size="mini" data-key="{{item.key}}" bindtap="claim" disabled="{{busy||item.claimed}}">{{item.claimed?'已领取':'领取'}}</button></view><view class="notice">首单券：客户发布首个需求后可领；工程师完成首个订单后可领。每项活动每账号限领一次，卡券90天有效；支付抵扣尚未启用。</view>
<view class="finance-tabs"><button class="{{tab==='coupons'?'active':''}}" data-tab="coupons" bindtap="tab">我的卡券</button><button class="{{tab==='coins'?'active':''}}" data-tab="coins" bindtap="tab">仿真币明细</button></view>
<block wx:if="{{tab==='coupons'}}"><view class="card coupon {{item.status}}" wx:for="{{info.coupons}}" wx:key="id"><view class="between"><view class="finance-value">¥{{item.amount}}</view><view>{{item.status==='EXPIRED'?'已过期':'已领取 · 待启用抵扣'}}</view></view><view>{{item.title}}</view><view class="caption">满 ¥{{item.min}} · 到期 {{item.expiresAt}}</view></view><view wx:if="{{!info.coupons.length}}" class="empty">暂无卡券</view></block><block wx:else><view class="card between" wx:for="{{info.coins}}" wx:key="id"><view class="grow"><view>{{item.label}}</view><view class="caption">{{item.periodKey}} · {{item.createdAt}}</view></view><text class="finance-value">+{{item.amount}}</text></view><view wx:if="{{!info.coins.length}}" class="empty">暂无仿真币明细</view></block><button wx:if="{{info.nextOffset!==null}}" bindtap="more">加载更多</button></block></view>
