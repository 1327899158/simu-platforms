page{background:#faf8f3}.benefits-page{padding:28rpx 32rpx 60rpx;color:#303a40}.page-heading{font-size:34rpx;font-weight:700;margin-bottom:26rpx}.coin-hero{position:relative;overflow:hidden;padding:36rpx 32rpx;background:linear-gradient(150deg,#f5a623,#ff7a45);border-radius:28rpx;color:white}.coin-hero::after{content:"";position:absolute;right:-60rpx;top:-70rpx;width:240rpx;height:240rpx;border-radius:50%;background:rgba(255,255,255,.14);pointer-events:none}.hero-label{font-size:26rpx}.balance{font-size:72rpx;font-weight:800;margin:8rpx 0}.hero-description{font-size:24rpx;opacity:.9}.hero-actions{display:flex;gap:18rpx;margin-top:30rpx}.hero-actions button{flex:1;min-width:0;margin:0;padding:0 12rpx;background:white;color:#d77d22;border-radius:16rpx;line-height:76rpx;font-size:25rpx;font-weight:700}.hero-actions button::after{border:none}.hero-actions .invite-button{background:rgba(255,255,255,.18);border:1rpx solid rgba(255,255,255,.4);color:white}.coin-stats{display:flex;text-align:center;margin-top:22rpx;padding:28rpx 14rpx;background:white;border-radius:24rpx}.coin-stats view{flex:1;font-size:20rpx;color:#92989c}.coin-stats text{display:block;font-size:33rpx;color:#3c4246;font-weight:700;margin-bottom:8rpx}.section-title{font-size:29rpx;font-weight:700;margin:34rpx 0 20rpx}.grow{flex:1;min-width:0}.task,.offer,.ledger-row,.coupon{display:flex;align-items:center;gap:20rpx;padding:26rpx;background:white;border-radius:22rpx;margin-bottom:16rpx;font-size:27rpx}.task-icon{width:72rpx;height:72rpx;border-radius:18rpx;background:#fff4db;color:#cf9a40;font-size:22rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.caption{font-size:22rpx;color:#969ca2;line-height:1.6;margin-top:8rpx}.task-amount{font-size:24rpx;color:#ec9440;font-weight:700;flex-shrink:0}.usage-grid{display:flex;gap:18rpx}.usage-card{flex:1;background:white;padding:28rpx 24rpx;border-radius:22rpx;min-width:0;font-size:26rpx;font-weight:700}.usage-card image{width:50rpx;height:50rpx;margin-bottom:16rpx}.usage-card text{display:block;font-weight:400;font-size:22rpx;line-height:1.6;color:#969ca2;margin-top:10rpx}.usage-rules{padding:24rpx 28rpx;border-radius:22rpx;background:#f0f2f4}.usage-rules view{font-size:24rpx;color:#66737b;line-height:1.8;margin:10rpx 0}.offer text{display:block;color:#ed9440;font-weight:700;margin-top:8rpx}.offer button{margin:0;padding:0 22rpx;line-height:62rpx;background:#fff3dc;border-radius:999rpx;color:#cf8c37;font-size:24rpx}.offer button::after{border:none}.offer button[disabled]{color:#a7a6a2;background:#f4f4f2}.ledger-tabs{display:flex;gap:40rpx;margin:34rpx 0 20rpx;font-size:29rpx;color:#909698}.ledger-tabs view{padding:10rpx 0}.ledger-tabs .active{color:#3a4349;font-weight:700;border-bottom:5rpx solid #f1a648}.ledger-row{justify-content:space-between}.ledger-row text{font-size:22rpx;color:#969ca2;display:block;margin-top:8rpx}.ledger-row .ledger-amount{font-size:32rpx;font-weight:700;margin:0}.ledger-row .income{color:#47986e}.ledger-row .expense{color:#de7655}.coupon-value{font-size:44rpx;font-weight:800;color:#e99737;min-width:145rpx}.coupon text{display:block;font-size:22rpx;color:#979fa3;line-height:1.7}.coupon.EXPIRED{opacity:.5}.empty{text-align:center;font-size:25rpx;color:#969ca2;padding:40rpx}.more{font-size:26rpx;background:white;color:#926b3c;border-radius:18rpx}.error{padding:24rpx;background:#fff0e7;border-radius:18rpx;color:#be7057;margin-bottom:20rpx}
