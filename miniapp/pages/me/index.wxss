/* pages/me/index.wxss · 布局迁移自 new_simu profile（浅色商务适配） */

.page-container {
  min-height: 100vh;
  background: var(--bg-base);
  padding: 24rpx 24rpx calc(148rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

@import "../../theme.wxss";

/* ===== 用户卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  background: var(--grad-hero-sunny);
  border-radius: var(--r-md);
  padding: 32rpx 24rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--bg-deep);
  flex-shrink: 0;
  border: 2rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--c-text-3);
  overflow: hidden;
}
.info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 6rpx;
}
.phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.phone {
  font-size: 24rpx;
  color: var(--c-text-3);
}
.bind-phone-btn {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: var(--neon-cyan);
  color: #FFFFFF;
  border: none;
  border-radius: var(--r-pill);
  line-height: 1.6;
  margin: 0;
}
.bind-phone-btn::after { border: none; }
.role {
  font-size: 24rpx;
  color: var(--neon-violet);
  font-weight: 500;
}
.edit-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--neon-violet);
  background: var(--bg-card);
  border: 1rpx solid var(--neon-violet);
  border-radius: var(--r-pill);
  padding: 8rpx 28rpx;
  line-height: 1.5;
  margin: 0;
}
.edit-btn::after { border: none; }
.edit-btn:active {
  background: var(--neon-violet);
  color: #FFFFFF;
}

/* ===== 身份认证（演示） ===== */
.verify-card {
  background: var(--bg-card);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.verify-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.verify-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.verify-title {
  color: var(--c-text);
  font-size: 30rpx;
  font-weight: 600;
}
.verify-desc,
.verify-hint {
  color: var(--c-text-3);
  font-size: 23rpx;
  margin-top: 8rpx;
}
.verify-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
}
.verify-status.approved { color: #16A34A; }
.verify-status.pending { color: #D97706; }
.verify-status.rejected { color: #DC2626; }
.verify-btn {
  width: 100%;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  margin: 24rpx 0 0;
  border: none;
  border-radius: var(--r-md);
  background: var(--neon-violet);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.verify-btn::after { border: none; }
.verify-btn:active { opacity: 0.82; }
.verify-btn[disabled] { opacity: 0.55; }

/* ===== 菜单 ===== */
.menu {
  background: var(--bg-card);
  border-radius: var(--r-md);
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--c-divider);
  transition: background 0.2s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: var(--bg-deep);
}
.menu-item .icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-item .title {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
}
.menu-item .arrow {
  font-size: 36rpx;
  color: var(--c-text-4);
  flex-shrink: 0;
}

/* ===== 操作 ===== */
.actions {
  margin-top: 40rpx;
}
.btn-danger-block {
  width: 100%;
  padding: 22rpx 0;
  background: var(--neon-red);
  color: #FFFFFF;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}
.btn-danger-block::after { border: none; }
.btn-danger-block:active {
  background: #C0392B;
  transform: scale(0.98);
}

/* ===== design rebuild ===== */
.verify-card { background: #5BC0EB; border: none; border-radius: 32rpx; }
.verify-title { color: #FFFFFF; }
.verify-desc { color: rgba(255,255,255,0.85); }
.verify-status { background: #F5D33F; color: #1F2B22; border-radius: 10rpx; padding: 4rpx 16rpx; }
.verify-btn { background: #F5D33F; color: #1F2B22; border-radius: 999rpx; font-weight: 700; }
.menu { background: #FFFFFF; border-radius: 32rpx; box-shadow: 0 2rpx 12rpx rgba(70,110,60,0.06); }

/* ===== design 1:1 ===== */
.me-hero { flex-direction: row; align-items: center; gap: 24rpx; }
.me-avatar { width: 110rpx; height: 110rpx; border-radius: 50%; border: 4rpx solid #FFFFFF; flex-shrink: 0; overflow: hidden; }
.me-avatar-fb { display: flex; align-items: center; justify-content: center; background: rgba(91,192,235,.2); color: #2FA8DE; font-size: 44rpx; }
.me-info { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 10rpx; }
.me-name { font-size: 36rpx; font-weight: 800; color: #1F2B22; }
.me-edit { font-size: 24rpx; color: #2FA8DE; }
.data-card-y .stat { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.data-card-y .stat b { font-size: 40rpx; font-weight: 800; color: #1F2B22; }
.data-card-y .stat span { font-size: 22rpx; color: #7C877B; }
.sky-copy { display: flex; flex-direction: column; gap: 6rpx; }
.sky-title { font-size: 30rpx; font-weight: 800; }
.sky-desc { font-size: 23rpx; color: rgba(255,255,255,.85); }
.verify-hint { display: block; margin: -8rpx 8rpx 20rpx; font-size: 22rpx; color: #7C877B; }
.self-verify { margin: 0 0 20rpx; background: #FFFFFF; color: #2FA8DE; border-radius: 999rpx; font-size: 26rpx; }
.logout-wrap { margin-top: 30rpx; }
.logout-wrap .btn-danger-outline {
  width: 100%;
  box-sizing: border-box;
}

/* 顶部身份信息、编辑操作与成长入口分层，避免标签挤在同一行。 */
.page-container .me-hero{display:flex;flex-wrap:wrap;gap:18rpx;padding:28rpx 12rpx}
.page-container .me-info{min-width:0;flex:1}
.page-container .me-name{font-size:34rpx;line-height:1.5;word-break:break-all}
.me-badges{display:flex;flex-wrap:wrap;gap:12rpx}
.page-container .me-edit{margin:0 0 0 auto;padding:14rpx 20rpx;border:1rpx solid #bfd8df;background:#f1f8f9;color:#447b8b;border-radius:24rpx;font-size:23rpx;line-height:1.5;flex-shrink:0}
.page-container .me-edit::after{border:none}
.page-container .badge-y{background:#f4edcd;color:#7a6b3d;font-size:23rpx}
.page-container .card-sky{display:flex;align-items:center;gap:20rpx;background:linear-gradient(115deg,#e4f3f8,#f0f8f7);border:1rpx solid #d4e6eb;color:#315c69;box-shadow:0 4rpx 18rpx rgba(70,110,125,.035);border-radius:26rpx}
.page-container .level-entry{background:linear-gradient(115deg,#f3efdb,#eef6ea);border-color:#e2e6d3}
.page-container .sky-copy{flex:1;min-width:0}.page-container .sky-title{font-size:29rpx;line-height:1.5;color:#375d65;word-break:break-all}
.page-container .sky-desc{font-size:23rpx;line-height:1.6;color:#71858a}
.entry-icon{font-size:42rpx;flex-shrink:0}.entry-arrow{font-size:34rpx;color:#809990;flex-shrink:0}
.page-container .btn-y{background:#fff5bf;color:#776728;border:1rpx solid #ece4bd;padding:12rpx 26rpx;font-size:24rpx;flex-shrink:0}
.page-container .data-card-y{background:rgba(255,255,255,.72);border:1rpx solid rgba(255,255,255,.8)}
.page-container .verify-hint{color:#6c8184;line-height:1.7;margin:0 12rpx 24rpx}
