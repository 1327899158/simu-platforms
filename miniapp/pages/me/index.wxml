<!-- pages/me/index.wxml · 设计稿 1:1 还原 -->
<view class="page-container">

  <view class="hero hero-sunny me-hero" wx:if="{{user}}">
    <image wx:if="{{user.avatarUrl}}" class="me-avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="me-avatar me-avatar-fb">{{user.nickname ? user.nickname[0] : '用'}}</view>
    <view class="me-info">
      <text class="me-name">Hi，{{user.nickname || '用户'}}</text>
      <view class="me-badges"><text class="badge-y">{{roleBadgeText}}</text></view>
    </view>
    <button class="me-edit" bindtap="goEdit">编辑资料 ›</button>
  </view>

  <view class="card-sky spread" bindtap="communityPage" data-page="benefits"><image class="entry-icon menu-vector" src="/assets/icons/award.svg" mode="aspectFit"/><view class="sky-copy"><text class="sky-title">卡券与仿真币</text><text class="sky-desc">活动卡券 · 签到奖励 · 收支明细</text></view><text>›</text></view>
  <view wx:if="{{user.role==='ENGINEER'}}" class="card-sky spread" bindtap="communityPage" data-page="wallet"><image class="entry-icon menu-vector" src="/assets/icons/quote.svg" mode="aspectFit"/><view class="sky-copy"><text class="sky-title">钱包、提现及银行卡绑定</text><text class="sky-desc">模拟余额账本 · 提现记录 · 测试绑卡</text></view><text>›</text></view>
  <view wx:if="{{user.role==='ENGINEER'}}" class="earnings-entry" bindtap="communityPage" data-page="earnings"><image src="/assets/icons/quote.svg" mode="aspectFit"/><view><text class="earnings-title">收益数据</text><text class="earnings-sub">完成金额 · 履约中金额 · 收益趋势</text></view><text class="earnings-arrow">›</text></view>
  <view class="card-sky spread level-entry" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goLevel"><image class="entry-icon menu-vector" src="/assets/icons/award.svg" mode="aspectFit"/><view class="sky-copy"><text class="sky-title">{{engineerLevel.name || '工程师等级'}}</text><text class="sky-desc">查看晋级条件，了解成长进度</text></view><text class="entry-arrow">›</text></view>
  <view class="data-card-y" wx:if="{{user}}">
    <view class="stat"><b>{{user.completedCount || 0}}</b><span>完成订单</span></view>
    <view class="stat"><b>{{user.averageScore || '—'}}</b><span>好评评分</span></view>
    <view class="stat"><b>{{user.reviewCount || 0}}</b><span>累计评价</span></view>
  </view>

  <view class="card-sky spread" wx:if="{{user}}" bindtap="goQualification">
    <view class="sky-copy">
      <text class="sky-title">身份认证</text>
      <text class="sky-desc">当前状态：{{verifyText}}</text>
    </view>
    <text class="btn-y">查看</text>
  </view>
  <text class="verify-hint" wx:if="{{user}}">{{qualificationHint}}</text>
  <button
    wx:if="{{user && showSelfVerify}}"
    class="self-verify"
    loading="{{selfVerifyLoading}}"
    disabled="{{selfVerifyLoading}}"
    catchtap="selfVerifyEngineer"
  >自主认证通过（调试）</button>

  <view class="menu-card" wx:if="{{user}}">
    <view class="menu-row" bindtap="goQualification">
      <image class="m-icon menu-vector" src="/assets/icons/identity.svg" mode="aspectFit"/>
      <text class="m-title">身份认证</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'CUSTOMER'}}" bindtap="goOrders">
      <image class="m-icon menu-vector" src="/assets/icons/orders.svg" mode="aspectFit"/>
      <text class="m-title">我的订单</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'CUSTOMER'}}" bindtap="goInvoices">
      <image class="m-icon menu-vector" src="/assets/icons/invoice.svg" mode="aspectFit"/>
      <text class="m-title">发票管理</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goMyQuotes">
      <image class="m-icon menu-vector" src="/assets/icons/quote.svg" mode="aspectFit"/>
      <text class="m-title">我的报价</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goCases"><image class="m-icon menu-vector" src="/assets/icons/cases.svg" mode="aspectFit"/><text class="m-title">案例展示</text><text class="m-arrow">›</text></view>
    <view class="menu-row" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goMyReviews">
      <image class="m-icon menu-vector" src="/assets/icons/review.svg" mode="aspectFit"/>
      <text class="m-title">我的评价</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'CUSTOMER' || user.role === 'ENGINEER'}}" bindtap="goBlacklist"><image class="m-icon menu-vector" src="/assets/icons/block.svg" mode="aspectFit"/><text class="m-title">黑名单</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="communityPage" data-page="favorites"><image class="m-icon menu-vector" src="/assets/icons/favorite.svg" mode="aspectFit"/><text class="m-title">我的收藏</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="communityPage" data-page="help"><image class="m-icon menu-vector" src="/assets/icons/help.svg" mode="aspectFit"/><text class="m-title">帮助、FAQ与关于我们</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="communityPage" data-page="support"><image class="m-icon menu-vector" src="/assets/icons/support.svg" mode="aspectFit"/><text class="m-title">意见反馈 / 我的举报</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="communityPage" data-page="cooperation"><image class="m-icon menu-vector" src="/assets/icons/cooperation.svg" mode="aspectFit"/><text class="m-title">常驻合作 / 定向需求</text><text class="m-arrow">›</text></view>
    <view class="menu-row" wx:if="{{user.role==='ENGINEER'}}" bindtap="communityPage" data-page="incentives"><image class="m-icon menu-vector" src="/assets/icons/award.svg" mode="aspectFit"/><text class="m-title">激励中心</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="communityPage" data-page="account-closure"><image class="m-icon menu-vector" src="/assets/icons/settings.svg" mode="aspectFit"/><text class="m-title">注销账号</text><text class="m-arrow">›</text></view>
    <view class="menu-row" bindtap="goMyDisputes">
      <image class="m-icon menu-vector" src="/assets/icons/dispute.svg" mode="aspectFit"/>
      <text class="m-title">我的纠纷</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goAccountSecurity">
      <image class="m-icon menu-vector" src="/assets/icons/security.svg" mode="aspectFit"/>
      <text class="m-title">{{user.username ? '重置密码' : '设置账号和密码'}}</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" wx:if="{{user.role === 'ENGINEER'}}" bindtap="goInvoices">
      <image class="m-icon menu-vector" src="/assets/icons/invoice.svg" mode="aspectFit"/>
      <text class="m-title">发票处理</text>
      <text class="m-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="switchRole">
      <image class="m-icon menu-vector" src="/assets/icons/switch.svg" mode="aspectFit"/>
      <text class="m-title">切换角色（演示）</text>
      <text class="m-arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap" wx:if="{{user}}">
    <button class="btn-danger-outline" bindtap="logout">退出登录</button>
  </view>

</view>
