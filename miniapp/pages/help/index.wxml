<view class="community"><view class="title">帮助与关于我们</view><button bindtap="feedback">意见反馈 / 我的反馈与举报</button><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 重试</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="muted">{{item.kind==='FAQ'?'常见问题':item.kind==='ABOUT'?'关于我们':'帮助说明'}}</view><view class="title">{{item.title}}</view><view class="body">{{item.content}}</view></view><view wx:if="{{!items.length&&!error}}" class="muted">管理员尚未发布帮助内容</view></view>
