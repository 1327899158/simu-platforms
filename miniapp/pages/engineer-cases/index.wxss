.case-page{padding:28rpx 28rpx 80rpx;background:#f3f6ef;min-height:100vh;box-sizing:border-box;color:#26392f}.case-hero{padding:32rpx;background:linear-gradient(135deg,#bee3f0,#ddebd9);border-radius:30rpx}.case-title{display:block;font-size:36rpx;font-weight:700;line-height:1.5}.case-muted{display:block;font-size:23rpx;color:#66796d;line-height:1.7;margin-top:12rpx}.primary{background:#355e4a;color:white}.preview{display:block;text-align:center;margin-top:24rpx;color:#355e4a;font-size:25rpx}.privacy{padding:24rpx;background:#fff4c8;border-radius:24rpx;margin:24rpx 0;font-size:23rpx;line-height:1.8}.case-card{background:white;border-radius:26rpx;padding:28rpx;margin:20rpx 0}.case-head{display:flex;gap:16rpx;align-items:flex-start;justify-content:space-between}.case-heading{display:block;font-size:29rpx;font-weight:700;line-height:1.5;overflow-wrap:anywhere}.case-summary{display:block;font-size:26rpx;line-height:1.8;white-space:pre-wrap;margin:20rpx 0;overflow-wrap:anywhere}.status{white-space:nowrap;font-size:21rpx;padding:7rpx 13rpx;background:#eee;border-radius:14rpx;color:#777}.status.active{background:#e2f1e4;color:#355e4a}.case-actions{display:flex;gap:20rpx;margin-top:22rpx}.case-actions button{flex:1;margin:0}.empty{display:block;text-align:center;padding:48rpx 16rpx;color:#6c796f;font-size:26rpx}.mask{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center}.dialog{width:88%;box-sizing:border-box;padding:30rpx;background:#fff;border-radius:30rpx;max-height:88vh}.picker-list{height:50vh}.editor-list{max-height:60vh}.candidate{padding:24rpx 0;border-bottom:1rpx solid #edf0e9;font-size:27rpx}.disabled{opacity:.5}.field-label{display:block;font-size:25rpx;font-weight:600;margin:24rpx 0 12rpx}input,textarea{box-sizing:border-box;width:100%;padding:18rpx;background:#f5f7f2;border-radius:16rpx;font-size:26rpx}input{height:82rpx}textarea{height:280rpx}.consent{display:flex;align-items:flex-start;font-size:23rpx;line-height:1.7;margin:24rpx 0}button{margin-top:20rpx;font-size:26rpx;border-radius:20rpx}button::after{border:none}

@import "../../theme.wxss";
