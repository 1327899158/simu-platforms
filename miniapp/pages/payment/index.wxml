<announcement-banner/>
<view class="community payment-page">
 <view class="hero illustrated-panel"><image class="panel-art" src="/assets/pay.png" mode="aspectFit" aria-hidden="true"/><view class="art-copy"><view class="eyebrow">ORDER CONFIRMATION</view><view class="title">{{success?'支付成功':'确认订单'}}</view><view class="muted">{{success?'订单状态已更新，可返回查看进度':'核对订单信息，安心开启合作'}}</view></view></view>
 <view wx:if="{{mode==='mock'}}" class="notice warning">模拟支付：现金部分不会实际扣款，使用的仿真币会从账户中扣除。</view>
 <view class="error" wx:if="{{error}}">{{error}}<button bindtap="load" disabled="{{busy||loading}}">刷新支付状态</button></view>
 <view wx:if="{{loading}}" class="muted">正在获取订单信息…</view>
 <block wx:if="{{order}}">
  <view class="card"><view class="between"><image wx:if="{{order.engineer.avatarUrl}}" class="avatar" src="{{order.engineer.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">工</view><view class="grow"><view class="title">{{order.engineer.nickname||'已选工程师'}}</view><view class="muted">本订单合作工程师</view></view></view><view class="list-row"><view class="title">{{order.projectName}}</view><view class="caption">交付要求以订单及已选报价约定为准</view></view></view>
  <view class="section-title">费用明细</view><view class="card"><view class="between list-row"><text>订单金额</text><text>¥{{grossText}}</text></view><view class="between list-row"><text>额外服务费</text><text>本次不另收取</text></view><view class="between list-row"><text>优惠券</text><text class="caption">暂未开放抵扣</text></view><coin-deduction wx:if="{{!success}}" id="payment-coins" amount-fen="{{grossAmountFen}}" locked="{{locked}}" busy="{{busy}}" held-coins="{{coins}}" bind:change="coinChange"/><view wx:if="{{success && coins}}">本单已使用 {{coins}} 仿真币抵扣</view><button wx:if="{{locked && !success}}" bindtap="cancelPending" disabled="{{busy}}">取消支付单，调整抵扣</button><view class="caption">合作折扣不重复扣减，应付金额以服务端支付单为准。</view><view class="between list-row"><text>应付总额</text><text class="payment-amount">¥{{amountText}}</text></view></view>
  <view class="section-title">支付方式</view><view class="card between"><text>{{amountFen===0?'仿真币支付':mode==='mock'?'模拟支付':'微信支付'}}</text></view>
  <view class="caption">每100仿真币抵扣1元，未支付时冻结，确认取消或支付超时后释放。</view>
  <view class="dock"><button wx:if="{{!success}}" class="primary" bindtap="confirmPay" loading="{{busy}}" disabled="{{busy||loading||error}}">{{amountFen===0?'确认仿真币支付':mode==='mock'?'确认模拟支付':'微信支付'}} ¥{{amountText}}</button><button wx:else class="primary" bindtap="back">返回订单 · 查看进度</button></view>
 </block>
</view>
