<view class="community" wx:if="{{ready}}"><view class="title">模拟钱包管理</view><view class="notice">仅超级管理员可操作。所有余额、绑卡、冻结和打款均为模拟；没有真实银行接口或真实付款动作。</view><view class="error" wx:if="{{error}}" bindtap="retry">{{error}}</view>
<view class="card"><view class="title">测试入账</view><input class="finance-input" data-key="userId" bindinput="field" value="{{userId}}" placeholder="工程师用户ID"/><input class="finance-input" data-key="amount" bindinput="field" value="{{amount}}" type="digit" placeholder="模拟入账金额（元）"/><textarea class="finance-input" data-key="note" bindinput="field" value="{{note}}" maxlength="300" placeholder="入账或审核处理说明（必填）"/><button bindtap="credit" disabled="{{busy}}" loading="{{busy}}">增加模拟余额</button></view>
<view class="section-title">提现申请</view><view class="card" wx:for="{{items}}" wx:key="id"><view class="between"><text>{{item.nickname}}</text><text class="finance-value">¥{{item.amount}}</text></view><view>{{item.label}}</view><view class="caption">{{item.bankLabel}} · {{item.createdAt}}</view><view class="finance-note">{{item.note}}</view><view class="finance-actions">
<button wx:if="{{item.status==='SUBMITTED'}}" data-id="{{item.id}}" data-status="APPROVED" bindtap="process" disabled="{{busy}}">审核通过</button><button wx:if="{{item.status==='SUBMITTED'||item.status==='APPROVED'}}" data-id="{{item.id}}" data-status="REJECTED" bindtap="process" disabled="{{busy}}">拒绝并解冻</button><button wx:if="{{item.status==='APPROVED'}}" data-id="{{item.id}}" data-status="PAYING" bindtap="process" disabled="{{busy}}">进入模拟打款</button><button wx:if="{{item.status==='PAYING'}}" data-id="{{item.id}}" data-status="PAID_SIMULATED" bindtap="process" disabled="{{busy}}">模拟打款成功</button><button wx:if="{{item.status==='PAYING'}}" data-id="{{item.id}}" data-status="FAILED" bindtap="process" disabled="{{busy}}">模拟失败解冻</button><button data-id="{{item.id}}" bindtap="events">处理记录</button></view></view><view wx:if="{{!items.length}}" class="empty">暂无提现申请</view><button wx:if="{{nextOffset!==null}}" bindtap="more">加载更多</button></view>
