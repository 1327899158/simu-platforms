@import "../../admin.wxss";
@import "../../console-theme.wxss";
.console-metrics {display:flex;flex-wrap:wrap;margin:20rpx -8rpx;}
.console-metrics .metric-cell {display:flex;box-sizing:border-box;flex:0 0 50%;width:50%;min-width:0;padding:8rpx;}
.metric-box {width:100%;min-width:0;box-sizing:border-box;background:#fff;padding:24rpx;border:1rpx solid #E4E6EF;border-radius:20rpx;}
.metric-number {display:block;font-size:36rpx;font-weight:700;color:#33469C;word-break:break-all;}
.metric-title {display:block;font-size:23rpx;color:#8A90A6;margin-top:10rpx;}
.console-row {display:flex;gap:20rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #E4E6EF;}
.console-row:last-child {border:0;padding-bottom:0;}
.row-title {display:block;font-size:27rpx;color:#171B2E;word-break:break-all;}
.row-subtitle {display:block;font-size:23rpx;color:#8A90A6;margin-top:8rpx;white-space:pre-wrap;word-break:break-all;}
.row-value {max-width:40%;font-size:25rpx;color:#33469C;text-align:right;word-break:break-all;}
.console-links {display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx;}
.console-links button {flex:1;min-width:220rpx;}
.field-label {display:block;margin:24rpx 0 12rpx;font-size:26rpx;}
.field-label.admin-between {display:flex;}
.admin-muted {display:block;margin:14rpx 0;word-break:break-all;}
.picker-value {display:flex;align-items:center;}
.permission-list {display:flex;gap:8rpx;flex-wrap:wrap;margin-top:16rpx;}
.permission-list text {font-size:20rpx;background:#EEF0FA;color:#33469C;padding:8rpx;border-radius:8rpx;}
.add-account {margin-top:20rpx;}
.status-pill {background:#E5F5EE;color:#0E8F58;padding:8rpx 16rpx;border-radius:30rpx;font-size:22rpx;}
.status-pill.muted {background:#F4F5F9;color:#8A90A6;}
.range-tabs {display:flex;background:#fff;padding:8rpx;border-radius:18rpx;margin-top:20rpx;}
.range-tabs>view {flex:1;text-align:center;padding:16rpx;font-size:25rpx;}
.range-tabs .active {background:#EEF0FA;color:#33469C;border-radius:12rpx;}

.hall-console .metric-title{min-height:68rpx;line-height:34rpx;margin:0 0 10rpx;font-size:24rpx}
.hall-console .metric-number{line-height:48rpx}
.hall-console .console-row{display:block;padding:24rpx 0}
.hall-console .row-value{display:inline-block;max-width:100%;text-align:left;margin-top:12rpx;padding:6rpx 14rpx;border-radius:10rpx;background:#EEF0FA;font-size:24rpx;box-sizing:border-box}
.hall-console .row-title{line-height:40rpx}
.direction-item{padding:26rpx 0;border-bottom:1rpx solid #E4E6EF}.direction-item:last-child{border:0}
.direction-heading{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12rpx;font-size:27rpx;font-weight:600;color:#171B2E}.direction-rate{font-size:23rpx;font-weight:400;color:#0E8F58}
.direction-counts{display:flex;flex-wrap:wrap;margin:14rpx -6rpx;font-size:23rpx;color:#4A5068}.direction-counts text{padding:4rpx 6rpx;min-width:30%;box-sizing:border-box}
.heat-track{height:12rpx;margin-top:10rpx;background:#F0F2F7;border-radius:8rpx;overflow:hidden}.heat-demand{height:100%;background:#4F6BFF;border-radius:8rpx}.heat-completed{height:100%;background:#0E8F58;border-radius:8rpx}

.operations-tabs{margin-top:20rpx;white-space:nowrap}.operations-tabs-inner{display:inline-flex;gap:12rpx;padding:8rpx 0}.operations-tab{padding:16rpx 24rpx;background:#fff;border-radius:28rpx;font-size:25rpx;color:#657087}.operations-tab.active{background:#33469c;color:#fff}

.plan-goal{box-sizing:border-box;width:100%;height:180rpx;margin:16rpx 0}

.funnel-step{font-size:25rpx;margin-top:20rpx}.funnel-track{height:16rpx;background:#eef0f7;border-radius:8rpx;margin-top:10rpx;overflow:hidden}.funnel-fill{height:100%;background:#5267c4;border-radius:8rpx}
