@import "../../admin.wxss";
@import "../../console-theme.wxss";
.console-metrics {display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0;}
.console-metrics>view {box-sizing:border-box;width:calc(50% - 8rpx);background:#fff;padding:24rpx;border:1rpx solid #E4E6EF;border-radius:20rpx;}
.metric-number {display:block;font-size:36rpx;font-weight:700;color:#33469C;word-break:break-all;}
.metric-title {display:block;font-size:23rpx;color:#8A90A6;margin-top:10rpx;}
.console-row {display:flex;gap:20rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #E4E6EF;}
.console-row:last-child {border:0;padding-bottom:0;}
.row-title {display:block;font-size:27rpx;color:#171B2E;word-break:break-all;}
.row-subtitle {display:block;font-size:23rpx;color:#8A90A6;margin-top:8rpx;white-space:pre-wrap;word-break:break-all;}
.row-value {max-width:40%;font-size:25rpx;color:#33469C;text-align:right;word-break:break-all;}
.console-links {display:flex;flex-wrap:wrap;gap:16rpx;margin-top:20rpx;}
.console-links button {flex:1;min-width:220rpx;}
.field-label {display:block;margin:24rpx 0 12rpx;font-size:26rpx;}
.field-label.admin-between {display:flex;}
.admin-muted {display:block;margin:14rpx 0;word-break:break-all;}
.picker-value {display:flex;align-items:center;}
.permission-list {display:flex;gap:8rpx;flex-wrap:wrap;margin-top:16rpx;}
.permission-list text {font-size:20rpx;background:#EEF0FA;color:#33469C;padding:8rpx;border-radius:8rpx;}
.add-account {margin-top:20rpx;}
.status-pill {background:#E5F5EE;color:#0E8F58;padding:8rpx 16rpx;border-radius:30rpx;font-size:22rpx;}
.status-pill.muted {background:#F4F5F9;color:#8A90A6;}
.range-tabs {display:flex;background:#fff;padding:8rpx;border-radius:18rpx;margin-top:20rpx;}
.range-tabs>view {flex:1;text-align:center;padding:16rpx;font-size:25rpx;}
.range-tabs .active {background:#EEF0FA;color:#33469C;border-radius:12rpx;}
