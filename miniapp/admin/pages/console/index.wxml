<view class="admin-page {{kind === 'hall' ? 'hall-console' : ''}}">
  <view class="admin-hero"><view class="admin-between"><text class="eyebrow">PLATFORM CONSOLE</text><text bindtap="home">工作台 ›</text></view><text class="admin-hero-title">{{title}}</text><text class="admin-hero-desc">{{subtitle}}</text></view>
  <view class="console-notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="error-panel" wx:if="{{error}}"><text>{{error}}</text><button size="mini" bindtap="retry">重新加载</button></view>
  <view class="range-tabs" wx:if="{{kind === 'finance' || kind === 'operations'}}"><view wx:for="{{dayOptions}}" wx:key="*this" class="{{days === item ? 'active' : ''}}" data-days="{{item}}" bindtap="range">近 {{item}} 天</view></view>
  <scroll-view wx:if="{{kind === 'operations'}}" scroll-x class="operations-tabs"><view class="operations-tabs-inner"><view wx:for="{{operationTabs}}" wx:key="key" class="operations-tab {{operationTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="changeOperationTab">{{item.label}}</view></view></scroll-view>
  <view class="console-metrics"><view class="metric-cell" wx:for="{{metrics}}" wx:key="title"><view class="metric-box"><text class="metric-title">{{item.title}}</text><text class="metric-number">{{item.value}}</text></view></view></view>
  <view class="admin-card" wx:if="{{kind === 'operations' && operationTab === 'overview' && !loading && !error}}"><text class="admin-card-title">需求转化概览</text><view wx:for="{{funnelSteps}}" wx:key="key" class="funnel-step"><view class="admin-between"><text>{{item.label}}</text><text>{{item.count}} 单</text></view><view class="funnel-track"><view class="funnel-fill" style="width:{{item.width}}%"></view></view></view></view>
  <view class="admin-card" wx:if="{{kind === 'hall' && directions.length}}">
    <text class="admin-card-title">领域供需热度</text>
    <text class="admin-muted">按需求数降序。蓝色为需求、绿色为完成；多方向订单每个方向只计一次，因此各方向合计可能超过总订单数。工程师数为当前认证通过且填写该方向的有效账号，不能直接视为可接单产能。</text>
    <view class="direction-item" wx:for="{{directions}}" wx:key="name">
      <view class="direction-heading"><text>{{item.name}}</text><text class="direction-rate">完成率 {{item.completionRate === null ? '—' : item.completionRate + '%'}}</text></view>
      <view class="direction-counts"><text>需求 {{item.demand}}</text><text>完成 {{item.completed}}</text><text>待报价 {{item.open}}</text><text>终止 {{item.terminated}}</text><text>工程师 {{item.engineers}}</text></view>
      <view class="heat-track"><view class="heat-demand" style="width:{{item.heat}}%"></view></view>
      <view class="heat-track"><view class="heat-completed" style="width:{{item.completedHeat}}%"></view></view>
    </view>
  </view>
  <view class="admin-card" wx:if="{{kind === 'operations' && operationTab === 'improve' && canSavePlan}}">
    <text class="admin-card-title">记录优化措施</text><text class="admin-muted">记录执行日期、目标领域和观察指标，便于后续复盘。最多保留100项。</text>
    <input class="admin-input" value="{{planTitle}}" maxlength="100" placeholder="措施名称，例如补充热分析工程师" data-key="planTitle" bindinput="inputPlan" disabled="{{planSaving}}"/>
    <picker mode="date" value="{{planDate}}" bindchange="pickPlanDate" disabled="{{planSaving}}"><view class="admin-input">{{planDate || '选择执行日期'}}</view></picker>
    <textarea class="admin-input plan-goal" value="{{planGoal}}" maxlength="500" placeholder="目标领域、具体措施、衡量指标及复盘时间" data-key="planGoal" bindinput="inputPlan" disabled="{{planSaving}}"/>
    <button class="admin-button" bindtap="savePlan" loading="{{planSaving}}" disabled="{{planSaving}}">保存措施</button>
  </view>
  <button wx:if="{{kind === 'operations' && (operationTab === 'users' || operationTab === 'supply')}}" class="admin-button secondary" data-path="/admin/pages/console/index?kind=hall" bindtap="open">查看退款、纠纷及关闭原因明细</button>
  <view class="console-links" wx:if="{{links.length}}"><button class="admin-button secondary" wx:for="{{links}}" wx:key="path" data-path="{{item.path}}" bindtap="open">{{item.title}} ›</button></view>
  <view class="admin-card" wx:if="{{kind === 'config' && !loading && !error}}"><text class="admin-card-title">大厅热门排序</text><text class="field-label">每条有效报价的热度权重（0–20）</text><input class="admin-input" type="number" value="{{hotQuoteWeight}}" bindinput="inputWeight" maxlength="2"/><text class="admin-muted">得分 = 浏览数 + 有效报价数 × 权重。只影响“热门”排序。</text><button class="admin-button" bindtap="saveConfig" loading="{{saving}}" disabled="{{saving}}">保存并生效</button></view>
  <block wx:if="{{kind === 'accounts' && !loading && !error}}">
    <button class="admin-button add-account" bindtap="newAccount" wx:if="{{!form}}">＋ 授权已有用户</button>
    <view class="admin-card" wx:if="{{form}}"><text class="admin-card-title">{{editing ? '调整管理员权限' : '新增管理员授权'}}</text><text class="field-label">用户ID</text><input class="admin-input" value="{{form.userId}}" disabled="{{editing || saving}}" data-key="userId" bindinput="inputForm" maxlength="32" placeholder="从用户详情复制用户ID"/><text class="field-label">管理员名称</text><input class="admin-input" value="{{form.displayName}}" data-key="displayName" bindinput="inputForm" maxlength="100"/><text class="field-label">角色</text><picker range="{{roles}}" range-key="label" value="{{form.roleIndex}}" bindchange="pickRole"><view class="admin-input picker-value">{{roles[form.roleIndex].label}}　⌄</view></picker><view class="permission-list"><text wx:for="{{roles[form.roleIndex].permissionLabels}}" wx:key="*this">{{item}}</text></view><view class="admin-between field-label"><text>启用此管理员</text><switch checked="{{form.status === 'ACTIVE'}}" bindchange="toggleStatus" color="#33469C"/></view><view class="console-links"><button class="admin-button secondary" bindtap="cancelForm" disabled="{{saving}}">取消</button><button class="admin-button" bindtap="saveAccount" loading="{{saving}}" disabled="{{saving}}">保存授权</button></view></view>
    <view class="admin-card" wx:for="{{accounts}}" wx:key="id"><view class="admin-between"><text class="admin-card-title">{{item.displayName}}</text><text class="status-pill {{item.status === 'ACTIVE' ? '' : 'muted'}}">{{item.statusText}}</text></view><text class="field-label">{{item.roleText}}</text><text class="admin-muted selectable" selectable>用户ID：{{item.userId}}</text><text class="admin-muted">最近登录：{{item.lastLoginText}}</text><button class="admin-button secondary" wx:if="{{item.userId !== admin.userId}}" data-id="{{item.id}}" bindtap="editAccount">调整权限</button><text class="admin-muted" wx:else>当前管理员账号</text></view>
    <view class="admin-empty" wx:if="{{!accounts.length}}">暂无管理员记录</view>
  </block>
  <view class="admin-card" wx:for="{{sections}}" wx:key="title" wx:for-item="section"><text class="admin-card-title">{{section.title}}</text><view class="console-row" wx:for="{{section.rows}}" wx:key="id" data-path="{{item.path}}" bindtap="open"><view class="admin-grow"><text class="row-title">{{item.title}}</text><text class="row-subtitle">{{item.subtitle}}</text></view><text class="row-value">{{item.value}}{{item.path ? ' ›' : ''}}</text></view><view class="admin-empty" wx:if="{{!section.rows.length}}">暂无记录</view></view>
  <button class="admin-button secondary" wx:if="{{hasMore}}" bindtap="more" loading="{{loading}}" disabled="{{loading}}">加载更多</button>
  <view class="admin-loading" wx:if="{{loading}}">正在加载真实业务数据…</view>
</view>
