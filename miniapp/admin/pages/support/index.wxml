<view class="community illustrated-panel"><image class="panel-art support-art" src="/assets/commit.png" mode="aspectFit" aria-hidden="true"/><view class="notice">处理结果及说明会同步给提交人，并写入审计日志。此入口不自动封禁、扣分或拉黑；需要账号处罚时请按核实结果另行处理。</view><block wx:if="{{detail}}"><button bindtap="back">返回列表</button><view class="card"><view class="title">{{detail.category}} · {{detail.statusText}}</view><view class="muted">提交人：{{detail.userId}} / 举报对象：{{detail.targetId||'无'}}</view><view class="body">{{detail.content}}</view><button wx:for="{{detail.evidence}}" wx:key="id" data-id="{{item.id}}" bindtap="preview">查看证据截图 {{index+1}}</button><view wx:for="{{detail.events}}" wx:key="createdAt" class="card">{{item.statusText}} · {{item.createdAt}}<view class="body">{{item.note}}</view></view><block wx:if="{{detail.status!=='RESOLVED'&&detail.status!=='REJECTED'}}"><textarea value="{{note}}" bindinput="input" placeholder="填写受理说明、调查进度或处理结论（提交人可见）" maxlength="3000"/><button wx:if="{{detail.status==='SUBMITTED'}}" data-status="ACCEPTED" bindtap="act" disabled="{{busy}}">受理</button><button wx:if="{{detail.status==='ACCEPTED'}}" data-status="INVESTIGATING" bindtap="act" disabled="{{busy}}">开始调查</button><button wx:if="{{detail.status!=='SUBMITTED'}}" data-status="RESOLVED" bindtap="act" disabled="{{busy}}">提交处理结果并结案</button><button data-status="REJECTED" bindtap="act" disabled="{{busy}}">不予受理 / 举报不成立</button></block></view></block><block wx:else><view class="row"><button data-kind="REPORT" bindtap="tab">用户举报</button><button data-kind="FEEDBACK" bindtap="tab">意见反馈</button></view><view class="error" bindtap="retry">{{error}}</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">{{item.nickname}} · {{item.category}}<view class="muted">{{item.statusText}} · {{item.createdAt}}</view></view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button></block></view>
