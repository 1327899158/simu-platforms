<view class="admin-page workbench">
  <view class="admin-hero">
    <view class="admin-between"><view><text class="eyebrow">SIMU · 管理工作台</text><text class="admin-hero-title">{{admin.displayName || '管理员'}}</text><text class="admin-hero-desc">{{admin.adminRoleText}} · 权限由平台授权</text></view><button class="exit-button" bindtap="exit">退出</button></view>
    <view class="hero-summary">当前待处理 <text class="hero-number">{{pending || 0}}</text> 项</view>
  </view>
  <view class="error-panel" wx:if="{{error}}"><text>{{error}}</text><button size="mini" bindtap="retry">重试</button></view>
  <block wx:if="{{tab === 'home'}}">
    <view class="section-heading">优先处理<text>点击卡片进入处理列表</text></view>
    <view class="priority-grid"><view class="priority-card" wx:for="{{priority}}" wx:key="key" data-path="{{item.path}}" bindtap="open"><view class="admin-between"><text class="priority-icon">{{item.icon}}</text><text class="pending-count {{item.count ? 'has-pending' : ''}}">{{item.count}}</text></view><text class="priority-title">{{item.title}}</text></view></view>
    <view class="section-heading">平台概览<text>支付统计含模拟模式提示</text></view>
    <view class="stats-grid" wx:if="{{overview}}">
      <view class="stat-box"><text class="stat-value">{{overview.todayOrders}}</text><text class="stat-label">今日新订单</text><text class="stat-extra">北京时间</text></view>
      <view class="stat-box"><text class="stat-value amount">¥{{todayPaid}}</text><text class="stat-label">今日成功支付记录</text><text class="stat-extra">当前{{overview.paymentMode === 'mock' ? '模拟支付' : '支付通道'}} · 非平台净收入</text></view>
      <view class="stat-box"><text class="stat-value">{{overview.quotingEngineers7d}}</text><text class="stat-label">近七日报价工程师</text><text class="stat-extra">按实际报价人数去重</text></view>
      <view class="stat-box"><text class="stat-value">{{overview.disputeResolutionRate === null ? '—' : overview.disputeResolutionRate + '%'}}</text><text class="stat-label">纠纷结案率</text><text class="stat-extra">已结案 / 非取消纠纷</text></view>
    </view><view class="admin-muted" wx:else>概览暂不可用，可下拉刷新；下方业务入口仍可使用。</view>
  </block>
  <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view class="nav-section" wx:if="{{tab === 'home' || (tab === 'review' && group.key === 'review') || (tab === 'operations' && group.key !== 'review')}}">
      <view class="section-heading" data-key="{{group.key}}" bindtap="toggle"><view>{{group.title}}<text>{{group.description}}</text></view><text>{{collapsed[group.key] ? '展开 ＋' : '收起 −'}}</text></view>
      <view class="menu-grid" wx:if="{{!collapsed[group.key]}}"><view class="menu-card" wx:for="{{group.items}}" wx:key="key" data-path="{{item.path}}" bindtap="open" hover-class="menu-pressed"><view class="menu-icon">{{item.icon}}<text class="menu-dot" wx:if="{{item.count}}"></text></view><view class="admin-grow"><text class="menu-title">{{item.title}}</text><text class="menu-desc">{{item.desc}}</text></view><text class="menu-count" wx:if="{{item.count}}">{{item.count}}</text></view></view>
    </view>
  </block>
  <view class="admin-loading" wx:if="{{loading}}">正在加载管理数据…</view>
  <view class="console-bottom"><view class="{{tab === 'home' ? 'active' : ''}}" data-tab="home" bindtap="selectTab">工作台</view><view wx:if="{{canReview}}" class="{{tab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="selectTab">审核与仲裁</view><view class="{{tab === 'operations' ? 'active' : ''}}" data-tab="operations" bindtap="selectTab">管理</view><view data-tab="data" bindtap="selectTab">数据看板</view></view>
</view>
