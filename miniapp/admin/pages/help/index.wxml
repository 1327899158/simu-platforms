<view class="community"><button bindtap="add">新增FAQ / 帮助 / 关于我们</button><view class="error" wx:if="{{error}}" bindtap="load">{{error}}</view><view wx:if="{{form}}" class="card"><picker range="{{kinds}}" bindchange="kind"><button>{{form.kind}} ›</button></picker><input placeholder="标题" value="{{form.title}}" data-key="title" bindinput="input" maxlength="120"/><textarea placeholder="正文" value="{{form.content}}" data-key="content" bindinput="input" maxlength="10000"/><input type="number" value="{{form.sortOrder}}" data-key="sortOrder" bindinput="input" placeholder="排序"/><view>公开展示 <switch checked="{{form.enabled}}" bindchange="toggle"/></view><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存并同步用户端</button><button bindtap="cancel">取消</button></view><view wx:for="{{items}}" wx:key="id" class="card"><view>{{item.title}}</view><view class="muted">{{item.kind}} · {{item.enabled?'已发布':'已下线'}}</view><button data-id="{{item.id}}" bindtap="edit">编辑 / 上下线</button></view></view>
