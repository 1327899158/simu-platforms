<view class="community"><view class="title">企业/机构认证审核</view><view class="notice">请核对企业、机构或毕业院校材料及其与申请人的关系。审核通过前填写公开展示标签，标签由管理员决定，请勿包含证件号码等隐私信息。</view><view class="error" wx:if="{{error}}" bindtap="load">{{error}}</view>
 <view class="card" wx:for="{{items}}" wx:key="userId"><view class="title">{{item.companyName}}</view><view>{{item.nickname}} · {{item.statusText}}</view><view>类型：{{item.certificationType==='SCHOOL'?'毕业院校':item.certificationType==='INSTITUTION'?'机构':'企业'}}</view><view class="muted" wx:if="{{item.creditCode}}">信用代码：{{item.creditCode}}</view><view wx:if="{{item.applicationNote}}">相关信息：{{item.applicationNote}}</view><view wx:if="{{item.status==='APPROVED'}}">展示标签：{{item.displayLabel || '企业已认证'}}</view><button wx:for="{{item.evidence}}" wx:for-item="fileId" wx:key="*this" data-id="{{fileId}}" bindtap="preview">查看资质图片 {{index+1}}</button><view class="muted" wx:if="{{item.result}}">审核意见：{{item.result}}</view><view wx:if="{{item.status==='PENDING'}}"><view>公开展示标签（通过时必填，最多40字）</view><input value="{{labels[item.userId] || ''}}" data-id="{{item.userId}}" bindinput="labelInput" maxlength="40" disabled="{{busy}}" placeholder="例如：某大学毕业、某机构认证"/></view><view class="row" wx:if="{{item.status==='PENDING'}}"><button data-id="{{item.userId}}" data-status="REJECTED" data-revision="{{item.revision}}" bindtap="review" disabled="{{busy}}">拒绝</button><button class="primary" data-id="{{item.userId}}" data-status="APPROVED" data-revision="{{item.revision}}" bindtap="review" disabled="{{busy}}">通过认证</button></view></view>
 <view class="muted" wx:if="{{!items.length && !error}}">暂无企业/机构认证申请</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button>
</view>
