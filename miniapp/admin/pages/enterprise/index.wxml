<view class="community"><view class="title">企业认证审核</view><view class="notice">请核对营业执照、企业名称、统一社会信用代码及申请人授权。通过后对外展示企业认证标识。</view><view class="error" wx:if="{{error}}" bindtap="load">{{error}}</view>
 <view class="card" wx:for="{{items}}" wx:key="userId"><view class="title">{{item.companyName}}</view><view>{{item.nickname}} · {{item.statusText}}</view><view class="muted">信用代码：{{item.creditCode}}</view><button wx:for="{{item.evidence}}" wx:for-item="fileId" wx:key="*this" data-id="{{fileId}}" bindtap="preview">查看资质图片 {{index+1}}</button><view class="muted" wx:if="{{item.result}}">审核意见：{{item.result}}</view><view class="row" wx:if="{{item.status==='PENDING'}}"><button data-id="{{item.userId}}" data-status="REJECTED" data-revision="{{item.revision}}" bindtap="review" disabled="{{busy}}">拒绝</button><button class="primary" data-id="{{item.userId}}" data-status="APPROVED" data-revision="{{item.revision}}" bindtap="review" disabled="{{busy}}">通过认证</button></view></view>
 <view class="muted" wx:if="{{!items.length && !error}}">暂无企业认证申请</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button>
</view>
