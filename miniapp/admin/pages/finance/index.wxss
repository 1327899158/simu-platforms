@import "../../admin.wxss";
@import "../../console-theme.wxss";
.finance-grid{display:flex;flex-wrap:wrap;margin:16rpx -8rpx}.finance-cell{width:50%;box-sizing:border-box;padding:8rpx;display:flex}.finance-metric{width:100%;box-sizing:border-box;background:white;border:1rpx solid #E4E6EF;border-radius:22rpx;padding:24rpx;display:flex;flex-direction:column}.metric-amount{display:block;font-size:34rpx;font-weight:700;margin:16rpx 0;word-break:break-all}.blue{color:#4F6BFF}.amber{color:#B5762A}.red{color:#C13B34}.green{color:#0E8F58}.finance-metric .admin-small:last-child{margin-top:auto}.admin-small{display:block}.date-row{display:flex;flex-wrap:wrap;align-items:center;gap:14rpx;margin-bottom:20rpx;font-size:24rpx}.date-row picker{padding:16rpx;background:white;border-radius:12rpx}.queue-row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid #E4E6EF;font-size:25rpx}.row-title{display:block;font-weight:600;word-break:break-all}.queue-link{color:#33469C;flex-shrink:0}.withdraw-amount{margin-top:24rpx;padding:40rpx;background:linear-gradient(135deg,#111827,#374151);color:white;text-align:center;border-radius:22rpx}.withdraw-amount text{display:block;font-size:24rpx}.withdraw-amount text:last-child{font-size:52rpx;font-weight:700;margin-top:12rpx;word-break:break-all}.reason{width:100%;box-sizing:border-box;margin:20rpx 0;height:180rpx}.action-row{display:flex;flex-wrap:wrap;gap:16rpx}.action-row button{flex:1;min-width:200rpx}
