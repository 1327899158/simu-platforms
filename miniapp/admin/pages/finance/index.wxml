<view class="admin-page">
 <block wx:if="{{!detail}}">
  <view class="admin-hero"><view class="admin-between"><text class="admin-hero-title">财务对账</text><button class="admin-button secondary small" bindtap="exportReport" disabled="{{loading || !!error}}">导出报表</button></view><text class="admin-hero-desc">收入、结算、提现与开票审核</text></view>
  <view class="admin-chips"><view wx:for="{{ranges}}" wx:key="key" class="admin-chip {{range === item.key ? 'active' : ''}}" data-range="{{item.key}}" bindtap="chooseRange">{{item.label}}</view></view>
  <view class="date-row" wx:if="{{range === 'custom'}}"><picker mode="date" value="{{start}}" data-key="start" bindchange="date"><view>{{start || '开始日期'}} ▾</view></picker><text>至</text><picker mode="date" value="{{end}}" data-key="end" bindchange="date"><view>{{end || '结束日期'}} ▾</view></picker><button class="admin-button small" bindtap="apply" disabled="{{loading}}">查询</button></view>
  <text class="admin-small">统计日期：{{start}} 至 {{end}}（北京时间）</text>
  <view class="finance-grid"><view wx:for="{{metrics}}" wx:key="label" class="finance-cell"><view class="finance-metric"><text class="admin-small">{{item.label}}</text><text class="metric-amount {{item.tone}}">{{item.value}}</text><text class="admin-small">{{item.note}}</text></view></view></view>
  <view class="console-notice">{{notice}}</view>
  <view class="admin-card"><text class="admin-card-title">推广服务收入来源</text><text class="admin-small">{{promotionBasis}}</text><view class="queue-row" wx:for="{{promotions}}" wx:key="key"><view class="admin-grow"><text class="row-title">{{item.label}} · {{item.unit}}/次</text><text class="admin-small">选择 {{item.count}} 次 · 实际收款：未接入</text></view><view><text class="row-title">{{item.estimated}}</text><text class="admin-small">标价测算</text></view></view></view>
  <view class="admin-card" wx:if="{{canWallet}}"><view class="admin-between"><text class="admin-card-title">大额提现复核</text><text class="admin-badge badge-orange">{{largeCount}} 笔待处理</text></view><text class="admin-small">仅超过 ¥5,000 进入此队列。≤ ¥5,000 的自动到账尚未接入，当前 {{smallCount}} 笔需在模拟钱包中处理。</text><view class="queue-row" wx:for="{{queue}}" wx:key="id" data-id="{{item.id}}" bindtap="withdrawal"><view class="admin-grow"><text class="row-title">{{item.nickname || '工程师'}} · {{item.amount}}</text><text class="admin-small">{{item.bankLabel}} · {{item.time}}</text><text class="admin-small">{{item.statusText}}</text></view><text class="queue-link">复核 ›</text></view><view class="admin-empty" wx:if="{{!queue.length}}">暂无大额待办</view><button class="admin-button secondary" bindtap="wallet">查看全部模拟提现</button></view>
  <view class="admin-card" wx:if="{{canInvoice}}"><text class="admin-card-title">开票申请队列</text><view class="queue-row" wx:for="{{invoices}}" wx:key="id" data-id="{{item.id}}" bindtap="invoice"><view class="admin-grow"><text class="row-title">{{item.orderNo}} · {{item.amount}}</text><text class="admin-small">{{item.projectName}} · {{item.invoiceTitle}}</text></view><text class="queue-link">处理 ›</text></view><view class="admin-empty" wx:if="{{!invoices.length}}">暂无平台开票申请</view><button class="admin-button secondary" bindtap="allInvoices">查看全部发票</button></view>
  <view class="admin-card"><text class="admin-card-title">成功支付记录 · {{paid}}</text><text class="admin-small">含历史模拟支付，不等于平台收入</text><view class="queue-row" wx:for="{{daily}}" wx:key="day"><text>{{item.day}} · {{item.count}} 笔</text><text>{{item.amount}}</text></view></view>
 </block>
 <block wx:else>
  <view class="admin-hero"><text class="admin-hero-title">提现复核详情</text><text class="admin-hero-desc">{{detail.nickname || '工程师'}} · {{detail.statusText}}</text></view>
  <view class="withdraw-amount"><text>申请提现金额（模拟）</text><text>{{detail.amount}}</text></view>
  <view class="admin-card"><text class="admin-card-title">提现信息</text><view class="detail-line"><text>收款方式</text><text>{{detail.bankLabel}}</text></view><view class="detail-line"><text>申请时间</text><text>{{detail.createdText}}</text></view><view class="detail-line"><text>复核原因</text><text>{{detail.amountFen > 500000 ? '超过 ¥5,000，人工复核' : '普通模拟提现'}}</text></view><view class="detail-line"><text>0.6% 费用测算</text><text>{{fee}}（未收费）</text></view><view class="detail-line"><text>税费前净额测算</text><text>{{net}}（非到账金额）</text></view></view>
  <view class="console-notice">当前为模拟钱包。费用仅按原型测算；审核、放款及完成分别记录处理状态，不会从对公账户或微信零钱转账。</view>
  <view class="admin-card" wx:if="{{actions.length}}"><text class="admin-card-title">复核处理</text><textarea class="reason" value="{{note}}" bindinput="inputNote" maxlength="300" placeholder="填写处理说明；拒绝时必须说明原因"/><view class="action-row"><button wx:for="{{actions}}" wx:key="status" class="admin-button {{item.danger ? 'danger' : ''}}" data-status="{{item.status}}" bindtap="process" loading="{{busy}}" disabled="{{busy}}">{{item.title}}</button></view></view>
  <view class="admin-card"><text class="admin-card-title">处理记录</text><view class="queue-row" wx:for="{{events}}" wx:key="index"><view><text class="row-title">{{item.label}}</text><text class="admin-small">{{item.note}}</text><text class="admin-small">{{item.time}}</text></view></view></view>
 </block>
 <view class="error-panel" wx:if="{{error}}" bindtap="retry">{{error}} · 点击重试</view><view class="admin-loading" wx:if="{{loading}}">正在加载…</view>
</view>
