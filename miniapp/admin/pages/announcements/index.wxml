<view class="community"><view class="title">公告管理</view><view class="notice">公告在有效期内向指定角色展示顶部滚动横幅。时间按北京时间填写；用户可关闭当前版本，修改后将作为新版本展示。</view><view class="error" wx:if="{{error}}" bindtap="load">{{error}}</view>
<block wx:if="{{!form}}"><button class="primary" bindtap="add">新增公告</button><view class="card" wx:for="{{items}}" wx:key="id"><view class="title">{{item.title}}</view><view>{{item.roleText}} · {{item.displayState}}</view><view class="body">{{item.content}}</view><button data-id="{{item.id}}" bindtap="edit">编辑 / 下线</button></view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button></block>
<view class="card" wx:else><input placeholder="公告标题" maxlength="80" data-key="title" bindinput="input" value="{{form.title}}"/><textarea placeholder="公告内容" maxlength="2000" data-key="content" bindinput="input" value="{{form.content}}"/><picker range="{{roles}}" value="{{form.roleIndex}}" bindchange="role"><view class="date-field">接收角色：{{roles[form.roleIndex]}} ›</view></picker><view>开始时间（北京时间）</view><view class="row"><picker mode="date" value="{{form.startDate}}" data-key="startDate" bindchange="input"><view class="date-field">{{form.startDate}}</view></picker><picker mode="time" value="{{form.startTime}}" data-key="startTime" bindchange="input"><view class="date-field">{{form.startTime}}</view></picker></view><view>结束时间（北京时间）</view><view class="row"><picker mode="date" value="{{form.endDate}}" data-key="endDate" bindchange="input"><view class="date-field">{{form.endDate}}</view></picker><picker mode="time" value="{{form.endTime}}" data-key="endTime" bindchange="input"><view class="date-field">{{form.endTime}}</view></picker></view><view class="between"><text>启用公告</text><switch checked="{{form.enabled}}" bindchange="toggle"/></view><view class="row"><button bindtap="cancel" disabled="{{busy}}">取消</button><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存公告</button></view></view></view>
