<view class="wrap"><text class="title">首页活动管理</text><button bindtap="add">新增活动</button><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><text class="heading">{{item.title}}</text><text>{{item.enabled?'展示中':'已下架'}} · 排序 {{item.sortOrder}} · 点击编辑</text></view><view class="card" wx:if="{{editing}}"><text class="heading">编辑活动</text><input placeholder="标题" value="{{editing.title}}" data-key="title" bindinput="input" maxlength="120"/><input placeholder="摘要" value="{{editing.subtitle}}" data-key="subtitle" bindinput="input" maxlength="240"/><textarea placeholder="活动规则" value="{{editing.content}}" data-key="content" bindinput="input" maxlength="5000"/><input type="number" placeholder="排序（小值优先）" value="{{editing.sortOrder}}" data-key="sortOrder" bindinput="input"/><picker range="{{labels}}" value="{{actionIndex}}" bindchange="action"><view>跳转：{{labels[actionIndex]}} ›</view></picker><view>首页展示 <switch checked="{{editing.enabled}}" bindchange="enable"/></view><button loading="{{saving}}" bindtap="save">保存活动</button></view></view>
