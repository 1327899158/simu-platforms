.wrap{padding:32rpx;background:#f3f6ef;min-height:100vh;color:#26392f}.title{display:block;font-size:40rpx;font-weight:700;margin:20rpx 0 24rpx}.heading{display:block;font-size:30rpx;font-weight:650;margin-bottom:22rpx}.card{background:white;border-radius:28rpx;padding:30rpx;margin:24rpx 0}.muted{display:block;color:#6c796f;font-size:25rpx;line-height:1.8;margin:16rpx 0}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chip{padding:16rpx 22rpx;background:#edf2e9;border-radius:18rpx;font-size:25rpx}.selected{background:#f9dc71;border:2rpx solid #d5ad26}.option{padding:22rpx;border-radius:18rpx;margin:12rpx 0;border:2rpx solid #edf0e9}.result{background:#fff2b9}.price{display:block;font-size:52rpx;font-weight:750;margin:30rpx 0}button{margin-top:24rpx;background:#355e4a;color:white;border-radius:20rpx;font-size:28rpx}.rules{display:block;white-space:pre-wrap;line-height:1.9}.avatar{width:92rpx;height:92rpx;border-radius:50%;float:right}input,textarea{box-sizing:border-box;width:100%;padding:16rpx;background:#f5f7f2;margin:14rpx 0;border-radius:12rpx}
