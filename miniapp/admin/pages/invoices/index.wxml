<view class="admin-page">
  <view class="admin-hero"><text class="admin-hero-title">发票管理</text><text class="admin-hero-desc">可查看申请并交付已实际开具的发票文件；税务自动开票、邮件及服务费未接入。</text></view>
  <view class="admin-chips"><view class="admin-chip {{status === item.key ? 'active' : ''}}" wx:for="{{filters}}" wx:key="key" data-status="{{item.key}}" bindtap="select">{{item.text}}</view></view>
  <view class="admin-empty" wx:if="{{!loading && !items.length}}">暂无发票申请</view>
  <view class="admin-card" wx:for="{{items}}" wx:key="id">
    <view class="admin-between"><text class="admin-card-title">{{item.invoiceTitle}}</text><text class="admin-badge badge-purple">{{item.statusText}}</text></view>
    <text class="admin-card-subtitle">订单：{{item.orderNo}} · {{item.projectName}}</text>
    <view class="admin-divider"></view>
    <text class="admin-muted">客户：{{item.customerName}}　工程师：{{item.engineerName}}</text>
    <text class="admin-small" wx:if="{{item.taxNumber}}">税号：{{item.taxNumber}}</text><text class="admin-small" wx:if="{{item.email}}">邮箱：{{item.email}}</text>
    <text class="admin-small" wx:if="{{item.customerNote}}">客户备注：{{item.customerNote}}</text><text class="admin-small" wx:if="{{item.engineerNote}}">工程师说明：{{item.engineerNote}}</text>
    <button wx:if="{{canProcess && item.status === 'PLATFORM_REQUESTED'}}" data-id="{{item.id}}" bindtap="deliverInvoice" loading="{{processingId === item.id}}" disabled="{{!!processingId}}">上传并交付平台发票</button>
    <view wx:for="{{item.files}}" wx:for-item="file" wx:key="fileId" data-id="{{file.fileId}}" bindtap="openFile" class="admin-small">📎 {{file.name}} · 查看/下载</view>
  </view>
  <view class="admin-loading" wx:if="{{loading}}">正在加载发票申请…</view>
</view>
