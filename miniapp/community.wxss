.community{padding:28rpx;background:#f4f8f7;min-height:100vh;box-sizing:border-box;padding-bottom:calc(50rpx + env(safe-area-inset-bottom));color:#213c32}.community .card{background:white;border-radius:22rpx;padding:26rpx;margin:20rpx 0;border:1rpx solid #e1eae5}.community .title{font-size:34rpx;font-weight:700;margin-bottom:16rpx}.community .muted{font-size:25rpx;color:#60766a;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}.community .notice{background:#e6f3ec;padding:24rpx;border-radius:18rpx;font-size:25rpx;line-height:1.7}.community input,.community textarea{background:#f5f7f6;box-sizing:border-box;padding:18rpx;margin:16rpx 0;border:1rpx solid #dbe5df;border-radius:12rpx;width:100%;font-size:28rpx}.community input{height:82rpx}.community textarea{height:230rpx}.community button{margin:18rpx 0;border-radius:16rpx;font-size:27rpx;background:#edf5f0;color:#235c42}.community .row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.community .row button{flex:1;min-width:120rpx}.community .active{background:#28634c;color:white}.community .error{color:#a34434;padding:24rpx}.community .avatar{width:68rpx;height:68rpx;border-radius:50%}.community .danger{color:#b7473c}.community .evidence{width:130rpx;height:130rpx;margin:10rpx}.community .body{white-space:pre-wrap;line-height:1.8;font-size:28rpx;overflow-wrap:anywhere}
