.more{padding:10rpx 20rpx;margin:0;border:1rpx solid #d2e2e4;border-radius:24rpx;background:#edf6f5;color:#416978;font-size:26rpx;line-height:1.5;letter-spacing:4rpx}.more::after,.action::after{border:0}.mask{position:fixed;inset:0;z-index:10000;background:rgba(24,44,48,.36);display:flex;align-items:flex-end}.sheet{width:100%;background:#f2f7f5;border-radius:30rpx 30rpx 0 0;padding:16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.handle{height:7rpx;width:64rpx;border-radius:8rpx;background:#d0dcdb;margin:0 auto 20rpx}.action{background:#fff;margin:0;padding:28rpx;font-size:29rpx;line-height:1.5;color:#344f56;border-radius:0;border-bottom:1rpx solid #ecf0ef}.report{color:#c64d49}.cancel{margin-top:16rpx;color:#85918f;border-radius:18rpx}.action[disabled]{opacity:.5}
