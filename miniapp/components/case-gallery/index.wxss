.gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:20rpx 0}.tile{position:relative;min-width:0;height:160rpx;border-radius:16rpx;background:#edf3f4;overflow:hidden}.photo{width:100%;height:100%;display:block}.placeholder{height:100%;display:flex;align-items:center;justify-content:center;font-size:20rpx;color:#667d8a;text-align:center}.remove{position:absolute;right:0;top:0;width:42rpx;height:42rpx;padding:0;margin:0;background:#334958;color:white;font-size:32rpx;line-height:38rpx;border-radius:0 0 0 14rpx}.remove::after{border:0}
