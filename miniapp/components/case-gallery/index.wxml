<view class="gallery" wx:if="{{pictures.length}}"><view class="tile" wx:for="{{pictures}}" wx:key="id"><image wx:if="{{item.url}}" class="photo" src="{{item.url}}" mode="aspectFill" data-id="{{item.id}}" bindtap="preview"/><view wx:else class="placeholder" data-id="{{item.id}}" bindtap="preview">{{item.error?'加载失败，点此重试':'加载中…'}}</view><button wx:if="{{editable}}" class="remove" data-id="{{item.id}}" catchtap="remove" aria-label="移除这张图片">×</button></view></view>
