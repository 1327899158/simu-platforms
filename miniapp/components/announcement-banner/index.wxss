.banner{display:flex;align-items:center;gap:14rpx;box-sizing:border-box;width:100%;min-height:70rpx;padding:12rpx 24rpx;background:#fff0c9;color:#865d25;border-bottom:1rpx solid #eddbb2}.banner image{width:32rpx;height:32rpx;flex-shrink:0}.viewport{flex:1;min-width:0;overflow:hidden}.scroll-text{display:inline-block;white-space:nowrap;font-size:25rpx;line-height:42rpx;animation:announcement-scroll linear infinite;padding-left:100%}.close{font-size:38rpx;line-height:44rpx;width:48rpx;text-align:center;flex-shrink:0}@keyframes announcement-scroll{from{transform:translateX(0)}to{transform:translateX(-100%)}}
