.exposure-panel{margin:24rpx 0;padding:28rpx;border:1rpx solid #c9dfe4;border-radius:20rpx;background:#f0f8fa;font-size:27rpx;line-height:1.7}.heading{font-size:30rpx;font-weight:700}.state{color:#337789;margin:12rpx 0}.hint{font-size:23rpx;color:#6c7d82;margin:12rpx 0}.quantity{display:flex;align-items:center;gap:20rpx}.quantity input{width:120rpx;background:#fff;padding:12rpx;border:1rpx solid #c9dfe4}.exposure-panel progress{margin:20rpx 0}.exposure-panel button{margin-top:20rpx;font-size:26rpx;background:#357d91;color:white}
