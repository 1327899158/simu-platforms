@import "../../community.wxss";
@import "../../theme.wxss";
.service-icon{width:80rpx;height:80rpx;flex-shrink:0}.body{margin-top:18rpx}

.linked-order{margin:24rpx 0;padding:24rpx;background:#edf5f7;border-radius:16rpx;word-break:break-all}.order-picker-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);display:flex;align-items:flex-end}.order-picker-panel{background:#fff;width:100%;padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;box-sizing:border-box}.order-picker-list{height:55vh}.order-option{padding:24rpx 0;border-bottom:1rpx solid #e4e9eb;word-break:break-all}.order-picker-panel .row input{flex:1;min-width:0}.order-picker-panel .between{display:flex;justify-content:space-between;align-items:center}

.service-chat{position:fixed;z-index:20;left:0;right:0;top:0;bottom:0;background:#f1f5f6;display:flex;flex-direction:column;overflow:hidden}.service-chat-head{display:flex;align-items:center;padding:14rpx;background:#fff;gap:18rpx}.service-chat-head button{margin:0;font-size:24rpx}.service-chat-messages{height:0;min-height:0;flex:1;padding:20rpx;box-sizing:border-box}.service-message{margin:20rpx 0;display:flex;flex-direction:column;align-items:flex-start}.service-message.mine{align-items:flex-end}.service-bubble{max-width:82%;padding:20rpx;border-radius:18rpx;background:white;white-space:pre-wrap;word-break:break-all}.mine .service-bubble{background:#d9eff5}.service-message.system{align-items:center;font-size:22rpx;color:#777}.service-chat-actions{display:flex;gap:12rpx;padding:10rpx;background:#fff}.service-chat-actions button{font-size:22rpx;margin:0}.service-composer{display:flex;gap:12rpx;padding:16rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));background:#fff}.service-composer input{flex:1;min-width:0;height:76rpx;background:#f3f5f7;padding:0 16rpx;border-radius:12rpx}.service-composer button{margin:0;font-size:26rpx;line-height:76rpx}
