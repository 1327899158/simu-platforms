@import "../../community.wxss";
@import "../../theme.wxss";
.service-icon{width:80rpx;height:80rpx;flex-shrink:0}.body{margin-top:18rpx}

.linked-order{margin:24rpx 0;padding:24rpx;background:#edf5f7;border-radius:16rpx;word-break:break-all}.order-picker-mask{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,.4);display:flex;align-items:flex-end}.order-picker-panel{background:#fff;width:100%;padding:28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;box-sizing:border-box}.order-picker-list{height:55vh}.order-option{padding:24rpx 0;border-bottom:1rpx solid #e4e9eb;word-break:break-all}.order-picker-panel .row input{flex:1;min-width:0}.order-picker-panel .between{display:flex;justify-content:space-between;align-items:center}

.service-chat{position:fixed;z-index:20;left:0;right:0;top:0;bottom:0;background:#f1f5f6;display:flex;flex-direction:column;overflow:hidden}.service-chat-head{display:flex;align-items:center;padding:14rpx;background:#fff;gap:18rpx}.service-chat-head button{margin:0;font-size:24rpx}.service-chat-messages{height:0;min-height:0;flex:1;padding:20rpx;box-sizing:border-box}.service-message{margin:20rpx 0;display:flex;flex-direction:column;align-items:flex-start}.service-message.mine{align-items:flex-end}.service-bubble{max-width:82%;padding:20rpx;border-radius:18rpx;background:white;white-space:pre-wrap;word-break:break-all}.mine .service-bubble{background:#d9eff5}.service-message.system{align-items:center;font-size:22rpx;color:#777}.service-chat-actions{display:flex;gap:12rpx;padding:10rpx;background:#fff}.service-chat-actions button{font-size:22rpx;margin:0}.service-composer{display:flex;gap:12rpx;padding:16rpx;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));background:#fff}.service-composer input{flex:1;min-width:0;height:76rpx;background:#f3f5f7;padding:0 16rpx;border-radius:12rpx}.service-composer button{margin:0;font-size:26rpx;line-height:76rpx}

.service-entry .card{margin-top:20rpx}.service-ticket-detail{padding-bottom:24rpx}.service-ticket-messages{max-height:55vh}.service-chat-actions{flex-wrap:wrap}

/* Isolated component: apply the admin visual treatment only when admin=true. */
.community.admin-service {background:#F5F7FB;background-image:none;padding:28rpx 32rpx;color:#171B2E;font-size:26rpx;}
.admin-service .hero {padding:8rpx 0 28rpx;margin-bottom:20rpx;background:transparent;border:0;border-bottom:1rpx solid #E4E6EF;border-radius:0;box-shadow:none;}
.admin-service .hero .title {font-size:36rpx;font-weight:700;color:#171B2E;}
.admin-service .caption {color:#8A90A6;font-size:22rpx;line-height:1.6;}
.admin-service .card {background:#fff;border:1rpx solid #E4E6EF;border-radius:22rpx;box-shadow:0 2rpx 4rpx rgba(16,24,40,.05);padding:28rpx;margin:20rpx 0;}
.admin-service button {min-height:68rpx;border-radius:40rpx;background:#EEF0FA;color:#33469C;padding:16rpx 24rpx;font-size:24rpx;line-height:1.5;box-shadow:none;}
.admin-service .primary {background:#33469C;color:#fff;}
.admin-service input,.admin-service textarea {background:#F9FAFB;border:1rpx solid #E4E6EF;border-radius:16rpx;color:#171B2E;font-size:26rpx;}
.admin-service .service-chat {background:#F5F7FB;}
.admin-service .service-chat-head {padding:20rpx 24rpx;border-bottom:1rpx solid #E4E6EF;background:#fff;color:#171B2E;}
.admin-service .service-chat-head button {min-height:60rpx;padding:12rpx 20rpx;flex-shrink:0;}
.admin-service .service-bubble {background:#fff;border:1rpx solid #E4E6EF;border-radius:4rpx 22rpx 22rpx;padding:22rpx 26rpx;font-size:26rpx;line-height:1.7;color:#171B2E;box-shadow:0 2rpx 4rpx rgba(16,24,40,.03);}
.admin-service .mine .service-bubble {background:#EEF0FA;border-color:#DFE3F5;color:#232F73;border-radius:22rpx 4rpx 22rpx 22rpx;}
.admin-service .system .service-bubble {border:0;background:transparent;box-shadow:none;color:#8A90A6;padding:8rpx;font-size:22rpx;}
.admin-service .service-chat-actions {border-top:1rpx solid #E4E6EF;padding:12rpx 24rpx;}
.admin-service .service-chat-actions button {min-height:56rpx;padding:10rpx 20rpx;font-size:22rpx;}
.admin-service .service-composer {align-items:center;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));gap:16rpx;}
.admin-service .service-composer input {margin:0;height:80rpx;}
.admin-service .service-composer button {margin:0;min-height:80rpx;padding:20rpx 28rpx;background:#33469C;color:#fff;line-height:1.5;border-radius:16rpx;}
.admin-service button[disabled] {opacity:.45;}

.service-message.system .service-bubble{background:transparent;border:0;box-shadow:none;color:#8A90A6;text-align:center;font-size:23rpx;line-height:1.6;padding:12rpx 20rpx}
