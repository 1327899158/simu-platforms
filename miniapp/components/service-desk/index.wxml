<view class="community {{admin ? 'admin-service' : ''}}"><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 重试</view>
 <block wx:if="{{!detail && !form}}">
  <view class="hero"><view class="title">{{admin?'客服工作台':'客服中心'}}</view><view class="caption">{{admin?'在线会话和工单分别处理':'在线聊天可直接咨询，复杂问题也可单独提交工单'}}</view></view>
  <view class="service-entry" wx:if="{{!admin}}"><view class="card"><view class="title">在线客服</view><view class="caption">直接发送消息，无需填写工单</view><button class="primary" bindtap="consult" disabled="{{busy}}" loading="{{busy}}">立即咨询</button></view><view class="card"><view class="title">提交工单</view><view class="caption">填写问题、材料及关联订单，跟进处理进度</view><button bindtap="create" disabled="{{busy}}">提交工单</button></view></view>
  <view class="row"><button class="{{channel==='CHAT'?'primary':''}}" data-channel="CHAT" bindtap="switchChannel">{{admin?'在线会话':'聊天记录'}}</button><button class="{{channel==='TICKET'?'primary':''}}" data-channel="TICKET" bindtap="switchChannel">{{admin?'工单处理':'我的工单'}}</button></view>
  <view class="card between" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="grow"><view>{{item.title}}</view><view class="caption">{{admin?item.nickname:''}} {{channel==='TICKET'?item.category:''}}</view></view><text>{{item.statusText}} ›</text></view>
  <view class="caption" wx:if="{{!items.length}}">{{channel==='CHAT'?'暂无聊天记录':'暂无工单'}}</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button>
  <block wx:if="{{!admin}}"><view class="section-title">常见问题</view><view class="card" wx:for="{{faq}}" wx:key="id" data-id="{{item.id}}" bindtap="faq">{{item.title}} ›</view></block>
 </block>
 <view class="card" wx:if="{{form}}"><view class="title">提交客服工单</view><picker range="{{categories}}" bindchange="category"><view>问题类型：{{category}} ›</view></picker><input data-key="title" bindinput="input" value="{{title}}" maxlength="120" placeholder="问题标题"/><textarea data-key="content" bindinput="input" value="{{content}}" maxlength="3000" placeholder="请详细描述问题（至少5个字）"/><view class="linked-order"><view class="section-title">关联订单（选填）</view><view wx:if="{{selectedOrder}}"><view>{{selectedOrder.projectName}}</view><text class="caption">订单号：{{selectedOrder.orderNo}}</text><button bindtap="removeOrder" disabled="{{busy}}">取消关联</button></view><button bindtap="chooseOrder" disabled="{{busy}}">{{selectedOrder?'更换订单':'获取订单'}}</button></view><view class="caption">可选截图，最多5张</view><view wx:for="{{evidence}}" wx:key="*this"><text data-id="{{item}}" bindtap="preview">截图 {{index+1}} ›</text><button data-id="{{item}}" bindtap="remove" disabled="{{busy}}">移除</button></view><button wx:if="{{evidence.length<5}}" bindtap="addImage" disabled="{{busy}}">添加截图</button><view class="row"><button bindtap="cancel" disabled="{{busy}}">返回</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交</button></view></view>
 <view wx:if="{{detail}}" class="{{detail.channel==='CHAT'?'service-chat':'service-ticket-detail'}}" style="bottom:{{keyboardHeight || 0}}px">
  <view class="service-chat-head"><button bindtap="back">‹ 返回</button><view>{{detail.title}}<view class="caption">{{detail.statusText}} · {{detail.channel==='CHAT'?'在线客服':'工单详情'}}</view></view></view>
  <scroll-view scroll-y class="{{detail.channel==='CHAT'?'service-chat-messages':'service-ticket-messages'}}" scroll-into-view="{{chatAnchor}}">
   <view class="card" wx:if="{{detail.channel!=='CHAT'}}"><view>{{detail.content}}</view><view wx:if="{{detail.relatedOrder}}">关联订单：{{detail.relatedOrder.projectName}}（{{detail.relatedOrder.orderNo}}）</view><button wx:for="{{detail.evidence}}" wx:key="*this" data-id="{{item}}" bindtap="preview">查看截图 {{index+1}}</button></view>
   <view class="service-message system" wx:if="{{!admin && detail.channel === 'CHAT'}}"><view class="service-bubble">您正在排队，请稍等客服回复。</view></view>
   <view wx:for="{{detail.messages}}" wx:key="id" class="service-message {{item.senderKind==='SYSTEM'?'system':(admin ? item.senderKind==='STAFF' : item.senderKind==='USER')?'mine':'peer'}}">
    <view class="caption">{{item.senderKind==='STAFF'?'客服':item.senderKind==='SYSTEM'?'系统':'用户'}} · {{item.createdAt}}</view><view class="service-bubble">{{item.content}}</view>
   </view>
   <view id="service-bottom" style="height:20rpx"></view>
  </scroll-view>
  <view class="service-chat-actions"><button wx:if="{{!admin && detail.channel==='CHAT' && detail.status!=='CLOSED'}}" bindtap="chooseOrder" disabled="{{busy}}">发送订单</button><button wx:if="{{admin && detail.channel!=='CHAT' && detail.status==='OPEN'}}" data-action="ACCEPT" bindtap="action" disabled="{{busy}}">受理</button><button wx:if="{{admin && (detail.status==='OPEN'||detail.status==='PROCESSING')}}" data-action="RESOLVE" bindtap="action" disabled="{{busy}}">已解决</button><button wx:if="{{detail.status!=='CLOSED'}}" data-action="CLOSE" bindtap="action" disabled="{{busy}}">关闭</button><button wx:if="{{detail.status==='CLOSED'||detail.status==='RESOLVED'}}" data-action="REOPEN" bindtap="action" disabled="{{busy}}">重新打开</button></view>
  <view class="service-composer" wx:if="{{detail.status!=='CLOSED'}}"><input value="{{reply}}" data-key="reply" bindinput="input" maxlength="3000" placeholder="{{detail.channel==='CHAT'?'输入消息，与客服沟通':'补充工单信息'}}" adjust-position="{{detail.channel!=='CHAT'}}" bindkeyboardheightchange="keyboardChange" confirm-type="send" bindconfirm="sendReply"/><button bindtap="sendReply" disabled="{{busy || !reply}}" loading="{{busy}}">发送</button></view>
 </view>
</view>

<view class="order-picker-mask" wx:if="{{orderPicker}}">
 <view class="order-picker-panel">
  <view class="between"><text class="title">选择关联订单</text><button bindtap="closeOrderPicker">关闭</button></view>
  <view class="row"><input value="{{orderSearch}}" bindinput="orderSearchInput" bindconfirm="searchOrders" maxlength="120" placeholder="搜索订单名称或订单号"/><button bindtap="searchOrders" disabled="{{orderLoading}}">搜索</button></view>
  <text class="error" wx:if="{{orderError}}">{{orderError}}</text>
  <scroll-view scroll-y class="order-picker-list">
   <view class="order-option" wx:for="{{orderItems}}" wx:key="id" data-id="{{item.id}}" bindtap="selectOrder"><view>{{item.projectName}} <text wx:if="{{item.id===suggestedOrderId}}">（当前订单）</text></view><text class="caption">订单号：{{item.orderNo}}</text></view>
   <view class="caption" wx:if="{{!orderItems.length&&!orderLoading&&!orderError}}">暂无可关联的订单</view>
   <button wx:if="{{orderHasMore}}" bindtap="moreOrders" disabled="{{orderLoading}}">加载更多</button>
   <view wx:if="{{orderLoading}}" class="caption">正在获取订单…</view>
  </scroll-view>
 </view>
</view>
