<view class="community"><view class="error" wx:if="{{error}}" bindtap="load">{{error}} · 重试</view>
 <block wx:if="{{!detail && !form}}"><view class="hero between"><image class="service-icon" src="/assets/icons/support.svg" mode="aspectFit"/><view class="grow"><view class="title">{{admin?'客服工作台':'在线客服'}}</view><view class="caption">{{admin?'受理、回复并跟进客户与工程师的问题':'提交后由客服回复，可随时查看处理进度'}}</view></view><button wx:if="{{!admin}}" bindtap="create">立即咨询</button></view><view class="section-title">{{admin?'客户与工程师工单':'我的工单'}}</view><view class="card between" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="grow"><view>{{item.title}}</view><view class="caption">{{item.category}} {{admin?item.nickname:''}}</view></view><text>{{item.statusText}} ›</text></view><view class="caption" wx:if="{{!items.length}}">暂无工单</view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button><block wx:if="{{!admin}}"><view class="section-title">常见问题</view><view class="card" wx:for="{{faq}}" wx:key="id" data-id="{{item.id}}" bindtap="faq">{{item.title}} ›</view><view wx:if="{{!faq.length}}" class="caption">常见问题正在整理，可直接咨询客服。</view></block></block>
 <view class="card" wx:if="{{form}}"><view class="title">提交客服工单</view><picker range="{{categories}}" bindchange="category"><view>问题类型：{{category}} ›</view></picker><input data-key="title" bindinput="input" value="{{title}}" maxlength="120" placeholder="问题标题"/><textarea data-key="content" bindinput="input" value="{{content}}" maxlength="3000" placeholder="请详细描述问题（至少5个字）"/><view class="linked-order"><view class="section-title">关联订单（选填）</view><view wx:if="{{selectedOrder}}"><view>{{selectedOrder.projectName}}</view><text class="caption">订单号：{{selectedOrder.orderNo}}</text><button bindtap="removeOrder" disabled="{{busy}}">取消关联</button></view><button bindtap="chooseOrder" disabled="{{busy}}">{{selectedOrder?'更换订单':'获取订单'}}</button></view><view class="caption">可选截图，最多5张</view><view wx:for="{{evidence}}" wx:key="*this"><text data-id="{{item}}" bindtap="preview">截图 {{index+1}} ›</text><button data-id="{{item}}" bindtap="remove" disabled="{{busy}}">移除</button></view><button wx:if="{{evidence.length<5}}" bindtap="addImage" disabled="{{busy}}">添加截图</button><view class="row"><button bindtap="cancel" disabled="{{busy}}">返回</button><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交</button></view></view>
 <block wx:if="{{detail}}"><button bindtap="back">返回工单列表</button><view class="card"><view class="title">{{detail.title}}</view><view>{{detail.category}} · {{detail.statusText}}</view><view class="body">{{detail.content}}</view><view class="linked-order" wx:if="{{detail.relatedOrder}}"><view class="caption">关联订单</view><view>{{detail.relatedOrder.projectName}}</view><text class="caption">订单号：{{detail.relatedOrder.orderNo}}</text></view><button wx:for="{{detail.evidence}}" wx:key="*this" data-id="{{item}}" bindtap="preview">查看截图 {{index+1}}</button></view><view class="section-title">沟通记录</view><view class="card" wx:for="{{detail.messages}}" wx:key="id"><view class="caption">{{item.senderKind==='STAFF'?'客服':item.senderKind==='SYSTEM'?'系统':'用户'}} · {{item.createdAt}}</view><view class="body">{{item.content}}</view></view><view class="caption">展示最近100条记录，页面每15秒刷新。</view><view class="card"><textarea wx:if="{{detail.status!=='CLOSED'}}" value="{{reply}}" data-key="reply" bindinput="input" maxlength="3000" placeholder="填写回复"/><button wx:if="{{detail.status!=='CLOSED'}}" data-action="REPLY" bindtap="action" disabled="{{busy}}">发送回复</button><view class="row"><button wx:if="{{admin && detail.status==='OPEN'}}" data-action="ACCEPT" bindtap="action" disabled="{{busy}}">受理</button><button wx:if="{{admin && (detail.status==='OPEN'||detail.status==='PROCESSING')}}" data-action="RESOLVE" bindtap="action" disabled="{{busy}}">标记已处理</button><button wx:if="{{detail.status!=='CLOSED'}}" data-action="CLOSE" bindtap="action" disabled="{{busy}}">关闭工单</button><button wx:if="{{detail.status==='CLOSED'||detail.status==='RESOLVED'}}" data-action="REOPEN" bindtap="action" disabled="{{busy}}">重新打开</button></view></view></block>
</view>

<view class="order-picker-mask" wx:if="{{orderPicker}}">
 <view class="order-picker-panel">
  <view class="between"><text class="title">选择关联订单</text><button bindtap="closeOrderPicker">关闭</button></view>
  <view class="row"><input value="{{orderSearch}}" bindinput="orderSearchInput" bindconfirm="searchOrders" maxlength="120" placeholder="搜索订单名称或订单号"/><button bindtap="searchOrders" disabled="{{orderLoading}}">搜索</button></view>
  <text class="error" wx:if="{{orderError}}">{{orderError}}</text>
  <scroll-view scroll-y class="order-picker-list">
   <view class="order-option" wx:for="{{orderItems}}" wx:key="id" data-id="{{item.id}}" bindtap="selectOrder"><view>{{item.projectName}} <text wx:if="{{item.id===suggestedOrderId}}">（当前订单）</text></view><text class="caption">订单号：{{item.orderNo}}</text></view>
   <view class="caption" wx:if="{{!orderItems.length&&!orderLoading&&!orderError}}">暂无可关联的订单</view>
   <button wx:if="{{orderHasMore}}" bindtap="moreOrders" disabled="{{orderLoading}}">加载更多</button>
   <view wx:if="{{orderLoading}}" class="caption">正在获取订单…</view>
  </scroll-view>
 </view>
</view>
