<view class="coin-box"><view class="coin-row"><view><view class="coin-heading">仿真币抵扣</view><view class="coin-hint">100仿真币 = 1元 · 可用 {{balance}} 币</view></view><switch checked="{{locked?heldCoins>0:selected}}" disabled="{{locked || busy || !maxCoins || !!error}}" color="#ec9840" bindchange="toggle"/></view><view wx:if="{{coins}}" class="coin-saving">使用 {{coins}} 币，抵扣 ¥{{deductionText}}</view><view wx:if="{{locked && heldCoins}}" class="coin-hint">本单已冻结 {{heldCoins}} 币，支付成功后扣除；取消支付单后可调整。</view><view wx:if="{{error}}" class="coin-hint" bindtap="load">{{error}}</view></view>
