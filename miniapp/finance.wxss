.finance-hero{padding:30rpx;background:#e6f0f6;border:1rpx solid #c2d8e1;border-radius:28rpx;margin:22rpx 0;color:#375a71}.finance-amount{font-size:52rpx;font-weight:750;margin:18rpx 0}.finance-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf0ef}.finance-value{font-weight:700;color:#927028;flex-shrink:0}.finance-tabs{display:flex;flex-wrap:wrap;gap:10rpx;margin:20rpx 0}.finance-tabs button{margin:0;font-size:24rpx;padding:10rpx 16rpx;line-height:1.4}.finance-tabs .active{background:#d6eaf1;color:#337693}.finance-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.finance-actions button{margin:0;font-size:23rpx;padding:10rpx 16rpx;line-height:1.5}.coupon{border-left:8rpx solid #edc45f}.coupon.EXPIRED{opacity:.55}.finance-input{margin:16rpx 0}.finance-note{font-size:23rpx;color:#7c8b90;line-height:1.7;overflow-wrap:anywhere}

